{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/resoltico/pdfconcat/blob/main/internal/core/internal/result/result.schema.json",
  "title": "PDFConcat result",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/version"
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "command",
        "status",
        "output",
        "pages",
        "fit_to",
        "diagnostics",
        "diagnostics_omitted",
        "report",
        "page_numbers"
      ],
      "properties": {
        "format_version": {
          "const": 6
        },
        "command": {
          "enum": [
            "build",
            "check",
            ""
          ]
        },
        "status": {
          "enum": [
            "ok",
            "invalid",
            "failed",
            "interrupted"
          ]
        },
        "output": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/output"
            }
          ]
        },
        "pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pages"
            }
          ]
        },
        "fit_to": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/size"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "diagnostics_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "report": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/report"
            }
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "page_numbers": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/page_numbers"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "parts"
            ]
          },
          "then": {
            "properties": {
              "diagnostics_omitted": {
                "const": 0
              },
              "diagnostics": {
                "items": {
                  "properties": {
                    "items_omitted": {
                      "const": 0
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "diagnostics": {
                "maxItems": 20,
                "items": {
                  "properties": {
                    "items": {
                      "maxItems": 20
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "parts"
            ]
          },
          "then": {
            "required": [
              "sections"
            ]
          },
          "else": {
            "not": {
              "required": [
                "sections"
              ]
            }
          }
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "command",
        "version",
        "commit",
        "go",
        "platform"
      ],
      "properties": {
        "format_version": {
          "const": 6
        },
        "command": {
          "const": "version"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]*$"
        },
        "go": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "published"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "published": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "sha256",
              "bytes"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "bytes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "generated",
        "total"
      ],
      "properties": {
        "source": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "generated": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "written"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "written": {
          "type": "boolean"
        }
      }
    },
    "size": {
      "type": "object",
      "description": "Width and height in points (1/72 inch). A generated part's size is its authored canvas before fitting; fit_to is the final sheet size.",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "offset",
        "pointer"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "pointer": {
          "type": "string"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "items_omitted"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "detail": {
          "type": "string"
        },
        "pdf_location": {
          "$ref": "#/$defs/pdfLocation"
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "kind",
        "pages",
        "output_pages",
        "text",
        "input_pages",
        "spans"
      ],
      "properties": {
        "item": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "page",
            "divider",
            "contents",
            "padding"
          ]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "output_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "text": {
          "description": "Measured text layout for a page item or divider. Null for empty text, unavailable layout, and source, contents or padding parts.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "fields_renamed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "input_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "spans": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "output"
            ],
            "properties": {
              "source": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "output": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "minItems": 1,
          "description": "Known source mappings are nonempty arrays; unresolved mappings and non-source parts are null."
        },
        "section": {
          "type": "string"
        },
        "reason": {
          "const": "odd_start"
        },
        "before_item": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "fields_renamed"
            ]
          },
          "else": {
            "properties": {
              "spans": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font",
        "font_size",
        "bounds",
        "ink_bounds",
        "overflow"
      ],
      "properties": {
        "font": {
          "type": "string",
          "description": "default for bundled Noto Sans, otherwise the resolved path of the selected font file."
        },
        "font_size": {
          "type": "number",
          "description": "Authored font size in points, before fitting.",
          "minimum": 1,
          "maximum": 14400
        },
        "bounds": {
          "type": "array",
          "description": "Logical text block as [left, bottom, right, top] in points from the lower-left corner of the authored page, before fitting. These are corner coordinates, not width and height.",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "ink_bounds": {
          "description": "Painted glyph bounds as [left, bottom, right, top] in points from the lower-left corner of the authored page, before fitting. Null when the measured text paints no glyphs, such as a whitespace-only block.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "overflow": {
          "type": "boolean"
        }
      }
    },
    "page_numbers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "margin"
      ],
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "title",
        "parent",
        "target_page",
        "output_pages"
      ],
      "properties": {
        "item": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "output_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          ]
        }
      }
    },
    "pdfLocation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "object": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
