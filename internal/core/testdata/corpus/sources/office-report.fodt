 <office:body><office:text>
  <text:h text:style-name="Title" text:outline-level="1">Office summary</text:h>
  <text:p text:style-name="Body">Fictional quarterly materials for PDFConcat. Pielikums Ā ļ ķ. Ελληνικά. Кириллица.</text:p>
  <table:table table:name="FictionalTable"><table:table-column table:number-columns-repeated="3"/><table:table-row><table:table-cell office:value-type="string"><text:p text:style-name="Body">Sample</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Body">Units</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p text:style-name="Body">Fictional total</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell><text:p text:style-name="Body">Paper prototype</text:p></table:table-cell><table:table-cell><text:p text:style-name="Body">12</text:p></table:table-cell><table:table-cell><text:p text:style-name="Body">208.20 EUR</text:p></table:table-cell></table:table-row></table:table>
  <text:p text:style-name="Body"><draw:rect draw:name="Original vector landmark" text:anchor-type="as-char" svg:width="12cm" svg:height="2cm"/></text:p>
  <text:p text:style-name="Body"><text:a xlink:href="https://example.invalid/fixture" xlink:type="simple">Offline fixture reference</text:a></text:p>
  <text:p text:style-name="Next">Office appendix</text:p>
  <text:h text:style-name="Body" text:outline-level="1">Appendix observations</text:h>
  <text:p text:style-name="Body">This source was authored for the public test corpus. All quantities and document statements are fictional.</text:p>
  <text:p text:style-name="Body">Unicode appendix: Ā ļ ķ Ελληνικά Кириллица. End of office source.</text:p>
