{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/resoltico/pdfconcat/blob/main/internal/report/report.schema.json",
  "title": "PDFConcat complete report, format 3",
  "type": "object",
  "properties": {
    "format_version": {
      "const": 3
    },
    "kind": {
      "const": "report"
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "failed",
        "interrupted"
      ]
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "phases": {
      "$ref": "#/$defs/phases"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[A-Z2-7]{26}$"
    },
    "diagnostic_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "format_version",
    "kind",
    "status",
    "command",
    "phases",
    "counts",
    "publication",
    "diagnostics",
    "parts",
    "sources",
    "fonts",
    "styles",
    "attempt_id",
    "diagnostic_count",
    "error_count",
    "warning_count"
  ],
  "additionalProperties": false,
  "$defs": {
    "state": {
      "enum": [
        "not_run",
        "incomplete",
        "complete"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "phases": {
      "type": "object",
      "properties": {
        "instructions": {
          "$ref": "#/$defs/state"
        },
        "input_inspection": {
          "$ref": "#/$defs/state"
        },
        "layout": {
          "$ref": "#/$defs/state"
        },
        "output_verification": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "instructions",
        "input_inspection",
        "layout",
        "output_verification"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "source_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "generated_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "source_pages",
        "generated_pages",
        "total_pages"
      ],
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "minLength": 1
        },
        "report_status": {
          "enum": [
            "not_requested",
            "written",
            "failed"
          ]
        },
        "report_path": {
          "type": "string",
          "minLength": 1
        },
        "recovery_report": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "type": "boolean"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recovery_state": {
          "enum": [
            "current",
            "publication_pending",
            "unavailable"
          ]
        },
        "report_write": {
          "enum": [
            "written",
            "not_written"
          ]
        },
        "report_target_observation": {
          "enum": [
            "unknown",
            "absent_when_observed"
          ]
        },
        "report_from": {
          "const": "original_argv.--report"
        }
      },
      "required": [
        "report_status",
        "published"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "recovery_report": [
          "recovery_state"
        ],
        "recovery_state": [
          "recovery_report"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "report_from"
            ]
          },
          "then": {
            "required": [
              "report_write",
              "report_target_observation"
            ],
            "properties": {
              "report_status": {
                "const": "failed"
              },
              "report_write": {
                "const": "not_written"
              },
              "report_target_observation": {
                "const": "unknown"
              }
            },
            "not": {
              "required": [
                "report_path"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "report_status": {
                "enum": [
                  "written",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "report_path"
                ]
              },
              {
                "required": [
                  "report_from"
                ]
              }
            ]
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "offset": [
          "line",
          "column"
        ],
        "line": [
          "offset",
          "column"
        ],
        "column": [
          "offset",
          "line"
        ]
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "argv_index": {
          "type": "integer",
          "minimum": 0
        },
        "pointer": {
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "offset": [
          "line",
          "column"
        ],
        "line": [
          "offset",
          "column"
        ],
        "column": [
          "offset",
          "line"
        ]
      },
      "not": {
        "required": [
          "argv_index",
          "pointer"
        ]
      }
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "#/$defs/location"
        },
        "stage": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "$ref": "#/$defs/name"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        },
        "cause": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "consequence_context": {
          "enum": [
            "predicted",
            "committed"
          ]
        }
      },
      "required": [
        "stage",
        "code",
        "message",
        "severity"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {
                "const": "warning"
              }
            }
          },
          "then": {
            "required": [
              "consequence_context"
            ]
          },
          "else": {
            "not": {
              "required": [
                "consequence_context"
              ]
            }
          }
        }
      ]
    },
    "range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(argv:(0|[1-9][0-9]*)|(/items/(0|[1-9][0-9]*))+)$"
        },
        "kind": {
          "enum": [
            "pdf",
            "blank"
          ]
        },
        "origin": {
          "$ref": "#/$defs/position"
        },
        "range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/range"
            }
          ]
        },
        "pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/index"
        },
        "style": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "kind",
        "origin",
        "range",
        "pages"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pdf"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ],
            "not": {
              "required": [
                "style"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "source"
              ]
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "path",
        "bytes"
      ],
      "additionalProperties": false
    },
    "font": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "digest",
        "name"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "explicit",
            "following_source",
            "preceding_source"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 14400
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 14400
        }
      },
      "required": [
        "origin",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 10000
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "anchor": {
          "enum": [
            "top-left",
            "top",
            "top-right",
            "left",
            "center",
            "right",
            "bottom-left",
            "bottom",
            "bottom-right"
          ]
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "overflow": {
          "enum": [
            "error",
            "allow"
          ]
        },
        "size": {
          "type": "number",
          "minimum": 1,
          "maximum": 14400
        },
        "x": {
          "type": "number",
          "minimum": -14400,
          "maximum": 14400
        },
        "y": {
          "type": "number",
          "minimum": -14400,
          "maximum": 14400
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 14400
        },
        "leading": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/rect"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "$ref": "#/$defs/index"
        },
        "ink_bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/rect"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/text_finding"
          }
        }
      },
      "required": [
        "value",
        "color",
        "anchor",
        "align",
        "overflow",
        "size",
        "x",
        "y",
        "width",
        "leading",
        "bounds",
        "font",
        "ink_bounds"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^(none|#[0-9a-f]{6})$"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "background",
        "size"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "go": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "tool",
        "version",
        "commit",
        "go",
        "platform"
      ],
      "additionalProperties": false
    },
    "text_finding": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "word-wider-than-box",
            "outside-page-horizontal",
            "outside-page-vertical"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": -1,
          "maximum": 9999
        }
      },
      "required": [
        "kind",
        "detail",
        "line"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "word-wider-than-box"
              }
            }
          },
          "then": {
            "properties": {
              "line": {
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "line": {
                "const": -1
              }
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "open_help",
            "edit_input",
            "choose_new_report",
            "inspect_report",
            "recover_report"
          ]
        },
        "command": {
          "enum": [
            "",
            "build",
            "check",
            "report",
            "schema",
            "version",
            "help"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "location_from": {
          "type": "string",
          "pattern": "^(|original_argv|original_argv\\.report_operand|complete_report\\.diagnostics/[0-9]{1,7}/recovery/location)$"
        },
        "replacement": {
          "type": "string",
          "pattern": "^(|--[a-z][a-z0-9-]{0,62}|-[a-zA-Z])$"
        },
        "report_from": {
          "enum": [
            "",
            "original_argv.--report",
            "original_argv.report_operand",
            "unused_report_target"
          ]
        },
        "recovery_from": {
          "enum": [
            "",
            "publication.recovery_report"
          ]
        }
      },
      "required": [
        "action",
        "command"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "open_help"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "edit_input"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "location"
                ]
              },
              {
                "required": [
                  "location_from"
                ],
                "properties": {
                  "location_from": {
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "choose_new_report"
              }
            }
          },
          "then": {
            "required": [
              "report_from"
            ],
            "properties": {
              "report_from": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "inspect_report"
              }
            }
          },
          "then": {
            "required": [
              "report_from"
            ],
            "properties": {
              "report_from": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "recover_report"
              }
            }
          },
          "then": {
            "required": [
              "recovery_from",
              "report_from"
            ],
            "properties": {
              "report_from": {
                "minLength": 1
              },
              "recovery_from": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "error_count": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "error_count": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
