+// parseCompleteObject adds a complete isolated-body boundary to the maintained prefix parser.
+func parseCompleteObject(c context.Context, pdf *model.Context, line *string, objNr int) (types.Object, error) {
+	value, err := parseObjectWithValidationPolicy(c, pdf, line, objNr)
+	if cancelErr := c.Err(); cancelErr != nil {
