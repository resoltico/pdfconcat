+
+package fileutil
+
+import (
+	"os"
+	"testing"
+)
+
+func denyFileCreation(t *testing.T, dir string) {
+	t.Helper()
+	if os.Geteuid() == 0 {
+		t.Skip("requires Unix directory permissions enforced for a non-root user")
+	}
+	t.Cleanup(func() {
+		if err := os.Chmod(dir, 0700); err != nil {
+			t.Error(err)
