+func objectBodyRemainder(c context.Context, remainder string) error {
+	comment := false
+	for index := range len(remainder) {
+		if index%filter.DecodeWorkChunk == 0 {
+			if err := c.Err(); err != nil {
+				return err
+			}
+		}
+		b := remainder[index]
+		if comment {
+			if b == '\n' || b == '\r' {
+				comment = false
+			}
+			continue
+		}
+		switch b {
+		case 0, 9, 10, 12, 13, 32:
+		case '%':
+			comment = true
+		default:
+			return errors.New("material trailing data after complete object body")
+		}
+	}
+	return c.Err()
+}
