+func TestPhysicalPositionsPreserveSourceTokens(t *testing.T) {
+	shared := token.NewFileSet()
+	shared.AddFile("gap", 100, 0)
+	for _, source := range []string{"", "//line /tmp/redirect_test.go:700:9\npackage p\nvar Value=1\n", "package p\n/*line /tmp/redirect.go:80*/var Value=2\n"} {
+		syntax, err := File(shared, "physical.go", []byte(source), parser.AllErrors|parser.ParseComments)
+		var current *token.File
+		shared.Iterate(func(f *token.File) bool { current = f; return true })
+		local := token.NewFileSet()
+		if current.Base() > 1 {
+			local.AddFile("", current.Base()-1, 0)
+		}
+		expected, wantErr := parser.ParseFile(local, "physical.go", source, parser.AllErrors|parser.ParseComments)
+		if (err == nil) != (wantErr == nil) {
+			t.Fatalf("parse error contract differs: %v/%v", err, wantErr)
+		}
+		if syntax != nil && syntax.Pos() != expected.Pos() {
+			t.Fatal("AST numeric positions changed")
+		}
+		for offset := 0; offset <= len(source); offset++ {
+			pos := current.Pos(offset)
+			if shared.PositionFor(pos, true) != local.PositionFor(pos, false) {
+				t.Fatalf("physical position differs at%d", offset)
+			}
+		}
+		if syntax != nil && len(syntax.Comments) != len(expected.Comments) {
+			t.Fatal("comments removed")
+		}
+	}
+	noPosition := shared.Position(token.NoPos)
+	if shared.File(token.NoPos) != nil || noPosition.IsValid() {
+		t.Fatal("NoPos acquired a file")
+	}
+}
+
+func TestConcurrentParsersKeepSharedRegistryAndFutureRanges(t *testing.T) {
+	shared := token.NewFileSet()
+	var group sync.WaitGroup
+	files := make(chan *ast.File, 32)
+	for i := 0; i < 32; i++ {
+		group.Add(1)
+		go func(index int) {
+			defer group.Done()
+			src := fmt.Sprintf("//line /tmp/fake.go:70\npackage p\nvar Value%d=1\n", index)
+			syntax, err := File(shared, fmt.Sprintf("physical%d.go", index), []byte(src), parser.ParseComments)
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			files <- syntax
+		}(i)
+	}
+	group.Wait()
+	close(files)
+	for syntax := range files {
+		if shared.Position(syntax.Pos()).Filename == "/tmp/fake.go" {
+			t.Fatal("adjusted position published")
+		}
+	}
+	next := shared.AddFile("future-export.go", -1, 20)
+	if shared.File(next.Pos(20)) != next {
+		t.Fatal("future source/export range lost")
+	}
+}
+
+type importedPackage struct{ pkg *types.Package }
+
+func (i importedPackage) Import(string) (*types.Package, error) { return i.pkg, nil }
+func TestImportedObjectPositionsUseOnePhysicalRegistry(t *testing.T) {
+	shared := token.NewFileSet()
+	dep, err := File(shared, "dependency.go", []byte("//line /tmp/fake-dependency.go:90\npackage dep\nvar Value=1\n"), parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	depPkg, err := new(types.Config).Check("example.org/dep", shared, []*ast.File{dep}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	value := depPkg.Scope().Lookup("Value")
+	var exported bytes.Buffer
+	if err := gcexportdata.Write(&exported, shared, depPkg); err != nil {
+		t.Fatal(err)
+	}
+	imported, err := gcexportdata.Read(bytes.NewReader(exported.Bytes()), shared, map[string]*types.Package{}, "example.org/dep")
+	if err != nil {
+		t.Fatal(err)
+	}
+	importedValue := imported.Scope().Lookup("Value")
+	if shared.Position(importedValue.Pos()).Filename != "dependency.go" {
+		t.Fatal("export/import file position changed")
+	}
+
+	consumer, err := File(shared, "consumer.go", []byte("//line /tmp/fake-consumer.go:700\npackage consumer\nimport \"example.org/dep\"\nvar Use=dep.Value\n"), parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := types.Config{Importer: importedPackage{imported}}
+	if _, err = cfg.Check("example.org/consumer", shared, []*ast.File{consumer}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if shared.Position(value.Pos()).Filename != "dependency.go" {
+		t.Fatal("imported object registry changed")
+	}
+	if shared.Position(consumer.Pos()).Filename != "consumer.go" {
+		t.Fatal("consumer registry changed")
+	}
+}
+
+func TestMappedSyntaxErrorUsesPhysicalSource(t *testing.T) {
+	shared := token.NewFileSet()
+	_, err := File(shared, "physical.go", []byte("//line /tmp/fake.go:99\npackage broken\nvar =\n"), parser.AllErrors|parser.ParseComments)
+	if err == nil {
+		t.Fatal("invalid syntax accepted")
+	}
+	if !strings.Contains(err.Error(), "physical.go:3:") || strings.Contains(err.Error(), "/tmp/fake.go") {
+		t.Fatalf("syntax error remapped: %v", err)
+	}
+}
