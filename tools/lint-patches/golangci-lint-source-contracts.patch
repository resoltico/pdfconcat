+package physicalparse
+
+import (
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/scanner"
+	"go/token"
+	"os"
+)
+
+// File parses unmodified source while keeping the shared position registry physical.
+// Compiler display directives remain in the syntax tree and in the original source.
+func File(shared *token.FileSet, filename string, src []byte, mode parser.Mode) (*ast.File, error) {
+	if src == nil {
+		data, err := os.ReadFile(filename)
+		if err != nil {
+			return nil, err
+		}
+		src = data
+	}
+	physical := shared.AddFile(filename, -1, len(src))
+	local := token.NewFileSet()
+	if physical.Base() > 1 {
+		local.AddFile("", physical.Base()-1, 0)
+	}
+	syntax, parseErr := parser.ParseFile(local, filename, src, mode)
+	parsed := local.File(token.Pos(physical.Base()))
+	if parsed == nil || parsed.Base() != physical.Base() || parsed.Size() != physical.Size() {
+		return nil, fmt.Errorf("physical parser position bounds differ for %s", filename)
+	}
+	if physical.Size() != 0 {
+		if !physical.SetLines(parsed.Lines()) {
+			return nil, fmt.Errorf("invalid physical line table for %s", filename)
+		}
+	}
+	var parseErrors scanner.ErrorList
+	if errors.As(parseErr, &parseErrors) {
+		for _, item := range parseErrors {
+			if item.Pos.Offset < 0 || item.Pos.Offset > physical.Size() {
+				return nil, fmt.Errorf("parser error offset outside physical source: %w", parseErr)
+			}
+			item.Pos = physical.PositionFor(physical.Pos(item.Pos.Offset), false)
+		}
+	}
+	return syntax, parseErr
+}
