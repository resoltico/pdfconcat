+// Equality and map-key operations read value fields implicitly. Preserve the
+// real operation owner, so dead functions do not make their key types live.
+func (g *graph) useComparableFields(typ types.Type, by types.Object, visited map[types.Type]bool) {
+	if typ == nil || visited[typ] {
+		return
+	}
+	visited[typ] = true
+	switch value := typ.Underlying().(type) {
+	case *types.Struct:
+		for field := range value.Fields() {
+			if field.Name() == "_" {
+				continue
+			}
+			g.use(field, by)
+			g.useComparableFields(field.Type(), by, visited)
+		}
+	case *types.Array:
+		if value.Len() > 0 {
+			g.useComparableFields(value.Elem(), by, visited)
+		}
+	}
+}
+
+func (g *graph) useMapKeyFields(mapping, key ast.Expr, by types.Object) {
+	if mapping == nil {
+		return
+	}
+	if value, ok := typeutil.CoreType(g.info.TypeOf(mapping)).(*types.Map); ok {
+		visited := map[types.Type]bool{}
+		g.useComparableFields(value.Key(), by, visited)
+		g.useComparableFields(g.info.TypeOf(key), by, visited)
+	}
+}
