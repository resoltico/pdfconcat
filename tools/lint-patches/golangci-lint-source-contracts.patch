+func TestComparableRepeatedValueTypeDAGPreservesBoundedTraversal(t *testing.T) {
+	// Build the valid shared type graph directly: the operation walker is under test,
+	// not go/types' separate recursive declaration-validity traversal.
+	fs := token.NewFileSet()
+	file := fs.AddFile("dag.go", -1, 1000)
+	pkg := types.NewPackage("fixture", "fixture")
+	owner := types.NewFunc(file.Pos(1), pkg, "owner", types.NewSignatureType(nil, nil, nil, nil, nil, false))
+	graph := newGraph(fs, nil, pkg, nil, nil, nil, DefaultOptions)
+	graph.use(owner, nil)
+	leaf := types.NewField(file.Pos(2), pkg, "leaf", types.Typ[types.Int], false)
+	name := types.NewTypeName(file.Pos(100), pkg, "branch0", nil)
+	pkg.Scope().Insert(name)
+	var branch types.Type = types.NewNamed(name, types.NewStruct([]*types.Var{leaf}, nil), nil)
+	for depth := 1; depth <= 24; depth++ {
+		left := types.NewField(file.Pos(2*depth+1), pkg, fmt.Sprintf("left%d", depth), branch, false)
+		right := types.NewField(file.Pos(2*depth+2), pkg, fmt.Sprintf("right%d", depth), branch, false)
+		name := types.NewTypeName(file.Pos(100+depth), pkg, fmt.Sprintf("branch%d", depth), nil)
+		pkg.Scope().Insert(name)
+		branch = types.NewNamed(name, types.NewStruct([]*types.Var{left, right}, nil), nil)
+	}
+	visited := map[types.Type]bool{}
+	graph.useComparableFields(branch, owner, visited)
+	if len(visited) != 26 {
+		t.Fatalf("visited %d types, want 25 shared value structs plus int", len(visited))
+	}
+	result := (&SerializedGraph{nodes: graph.nodes}).Results()
+	requireComparableClassification(t, result, "leaf", "used")
+	for depth := 1; depth <= 24; depth++ {
+		requireComparableClassification(t, result, fmt.Sprintf("left%d", depth), "used")
+		requireComparableClassification(t, result, fmt.Sprintf("right%d", depth), "used")
+	}
+}
