+func TestComparableOperationFieldsPreserveReachability(t *testing.T) {
+	cases := []struct {
+		name, operation string
+		used            bool
+	}{
+		{"lookup", "func F(){m:=map[key]int{}; _=m[key{}]}", true},
+		{"insert", "func F(){m:=map[key]int{};m[key{}]=1}", true},
+		{"update", "func F(){m:=map[key]int{};m[key{}]+=1}", true},
+		{"literal", "func F(){_ = map[key]int{key{}:1}}", true},
+		{"delete", "func F(){m:=map[key]int{};(delete)(m,key{})}", true},
+		{"equal", "func F(){_ = key{}==key{}}", true},
+		{"unequal", "func F(){_ = key{}!=key{}}", true},
+		{"switch", "func F(){switch (key{}) {case key{}:}}", true},
+		{"constructed", "func F(){_ = key{}}", false},
+		{"writtenUnread", "func F(){k:=key{};k.hidden=1;_=k}", false},
+		{"emptyMap", "func F(){_ = map[key]int{}}", false},
+		{"makeOnly", "func F(){_ = make(map[key]int)}", false},
+		{"lenOnly", "func F(m map[key]int){_=len(m)}", false},
+		{"rangeOnly", "func F(m map[key]int){for k:=range m{_=k}}", false},
+		{"clearOnly", "func F(m map[key]int){clear(m)}", false},
+		{"nilMap", "func F(m map[key]int){_=m==nil}", false},
+		{"mapValue", "func F(){m:=map[int]key{0:key{}};_=m[0]}", false},
+		{"defaultSwitch", "func F(){switch (key{}) {default:}}", false},
+		{"emptySwitch", "func F(){switch (key{}) {}}", false},
+		{"typeSwitch", "func F(k key){switch any(k).(type){case key:}}", false},
+		{"pointer", "func F(){_ = (*key)(nil)==(*key)(nil)}", false},
+		{"shadowDelete", "func delete(map[key]int,key){};func F(){delete(nil,key{})}", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			result := comparableFixtureResults(t, "type key struct{hidden int};"+tc.operation)
+			state := "unused"
+			if tc.used {
+				state = "used"
+			}
+			requireComparableClassification(t, result, "hidden", state)
+		})
+	}
+}
