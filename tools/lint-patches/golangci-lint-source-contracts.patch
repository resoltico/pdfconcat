+		{"alias", "type key struct{hidden int};type alias = key;func F(a,b alias)bool{return a==b}", []string{"hidden"}, nil},
+		{"instantiated", "type key[T comparable]struct{hidden T};func F(a,b key[int])bool{return a==b}", []string{"hidden"}, nil},
+		{"interfaceEquality", "type key struct{hidden int};func F(a any,b key)bool{return a==b}", []string{"hidden"}, nil},
+		{"interfaceLookup", "type key struct{hidden int};func F(m map[any]int,k key)int{return m[k]}", []string{"hidden"}, nil},
+		{"interfaceDelete", "type key struct{hidden int};func F(m map[any]int,k key){delete(m,k)}", []string{"hidden"}, nil},
+		{"interfaceLiteral", "type key struct{hidden int};func F(k key)any{return map[any]int{k:1}}", []string{"hidden"}, nil},
+		{"interfaceSwitchCase", "type key struct{hidden int};func F(k key,a any){switch a{case k:}}", []string{"hidden"}, nil},
+		{"pointerField", "type inner struct{nested int};type key struct{pointer *inner};func F(a,b key)bool{return a==b}", []string{"pointer"}, []string{"nested"}},
+		{"blank", "type inner struct{nested int};type key struct{_ inner;hidden int};func F(a,b key)bool{return a==b}", []string{"hidden"}, []string{"nested"}},
+		// The zero-length containing field is structurally compared; nonexistent elements are not read.
+		{"zeroArray", "type inner struct{nested int};type key struct{zero [0]inner};func F(a,b key)bool{return a==b}", []string{"zero"}, []string{"nested"}},
+		{"boxedOnly", "type key struct{hidden int};func F(k key)any{return k}", nil, []string{"hidden"}},
+		{"boxedHelper", "type key struct{hidden int};func box(k key)any{return k};func F(m map[any]int,k key)int{return m[box(k)]}", nil, []string{"hidden"}},
+		{"genericEqual", "type key struct{hidden int};func equal[T comparable](a,b T)bool{return a==b};func F(a,b key)bool{return equal(a,b)}", nil, []string{"hidden"}},
+		{"genericLookup", "type key struct{hidden int};func lookup[K comparable](m map[K]int,k K)int{return m[k]};func F(m map[key]int,k key)int{return lookup(m,k)}", nil, []string{"hidden"}},
+		{"genericIdentity", "type key struct{hidden int};func identity[T comparable](k T)T{return k};func F(k key)key{return identity(k)}", nil, []string{"hidden"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			result := comparableFixtureResults(t, tc.source)
+			for _, name := range tc.used {
+				requireComparableClassification(t, result, name, "used")
+			}
+			for _, name := range tc.unused {
+				requireComparableClassification(t, result, name, "unused")
+			}
+		})
+	}
+}
