+func TestMappedSyntaxErrorUsesPhysicalSource(t *testing.T) {
+	shared := token.NewFileSet()
+	_, err := File(shared, "physical.go", []byte("//line /tmp/fake.go:99\npackage broken\nvar =\n"), parser.AllErrors|parser.ParseComments)
+	if err == nil {
+		t.Fatal("invalid syntax accepted")
+	}
+	if !strings.Contains(err.Error(), "physical.go:3:") || strings.Contains(err.Error(), "/tmp/fake.go") {
+		t.Fatalf("syntax error remapped: %v", err)
+	}
+}
