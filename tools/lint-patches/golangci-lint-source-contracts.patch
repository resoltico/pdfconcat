+func TestComparableDeadOperationsCannotRootFields(t *testing.T) {
+	operations := []string{
+		"m:=map[key]int{};_=m[key{}]", "m:=map[key]int{};m[key{}]=1",
+		"_=map[key]int{key{}:1}", "m:=map[key]int{};delete(m,key{})",
+		"_=key{}==key{}", "_=key{}!=key{}", "switch (key{}){case key{}:}",
+	}
+	for index, operation := range operations {
+		t.Run(fmt.Sprint(index), func(t *testing.T) {
+			result := comparableFixtureResults(t, "type key struct{hidden int};func dead(){"+operation+"};func F(k key){}")
+			requireComparableClassification(t, result, "dead", "unused")
+			requireComparableClassification(t, result, "hidden", "unused")
+		})
+	}
+	result := comparableFixtureResults(t, "type key struct{hidden int};func dead(){_=key{}==key{}};func F(){}")
+	requireComparableClassification(t, result, "hidden", "quiet")
+}
