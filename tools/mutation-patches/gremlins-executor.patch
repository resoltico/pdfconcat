index 0000000..84f602e
--- /dev/null
+++ b/internal/engine/campaign_cancellation_test.go
@@ -0,0 +1,145 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package engine
+
+import (
+	"context"
+	"fmt"
+	"github.com/go-gremlins/gremlins/internal/configuration"
+	"github.com/go-gremlins/gremlins/internal/coverage"
+	"github.com/go-gremlins/gremlins/internal/engine/workdir"
+	"github.com/go-gremlins/gremlins/internal/gomodule"
+	"github.com/go-gremlins/gremlins/internal/mutator"
+	"github.com/go-gremlins/gremlins/internal/report"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCampaignCancellationRestoresSourceAndDrainsWorkers(t *testing.T) {
+	originalDirectory, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := os.Chdir(originalDirectory); err != nil {
+			t.Fatal(err)
+		}
+	}()
+	beforeLog := configuration.Get[string](configuration.UnleashExecutionLogDirKey)
+	beforeRun := configuration.Get[bool](configuration.UnleashRunUncoveredKey)
+	beforeIntegration := configuration.Get[bool](configuration.UnleashIntegrationMode)
+	beforeWorkers := configuration.Get[int](configuration.UnleashWorkersKey)
+	beforeCoefficient := configuration.Get[int](configuration.UnleashTimeoutCoefficientKey)
+	beforeBitwise := configuration.Get[bool](configuration.MutantTypeEnabledKey(mutator.InvertBitwise))
+	defer func() {
+		configuration.Set(configuration.UnleashExecutionLogDirKey, beforeLog)
+		configuration.Set(configuration.UnleashRunUncoveredKey, beforeRun)
+		configuration.Set(configuration.UnleashIntegrationMode, beforeIntegration)
+		configuration.Set(configuration.UnleashWorkersKey, beforeWorkers)
+		configuration.Set(configuration.UnleashTimeoutCoefficientKey, beforeCoefficient)
+		configuration.Set(configuration.MutantTypeEnabledKey(mutator.InvertBitwise), beforeBitwise)
+	}()
+	root := t.TempDir()
+	logs := t.TempDir()
+	scratch := t.TempDir()
+	heartbeat := filepath.Join(logs, "heartbeat")
+	source := "package cancellation\n"
+	for i := 0; i < 64; i++ {
+		source += fmt.Sprintf("const Bound%d = 1 << 2\n", i)
+	}
+	source += "func Value() int{return Bound0}\n"
+	mustWrite(t, filepath.Join(root, "go.mod"), "module cancellation.example\ngo 1.27.1\n")
+	mustWrite(t, filepath.Join(root, "value.go"), source)
+	testSource := fmt.Sprintf("package cancellation\nimport(\"testing\";\"os\";\"time\")\nfunc TestBehavior(t *testing.T){if Value()!=4{for{_=os.WriteFile(%q,[]byte(time.Now().String()),0600);time.Sleep(10*time.Millisecond)}}}\n", heartbeat)
+	mustWrite(t, filepath.Join(root, "value_test.go"), testSource)
+	configuration.Set(configuration.UnleashExecutionLogDirKey, logs)
+	configuration.Set(configuration.UnleashRunUncoveredKey, true)
+	configuration.Set(configuration.UnleashIntegrationMode, true)
+	configuration.Set(configuration.UnleashWorkersKey, 1)
+	configuration.Set(configuration.UnleashTimeoutCoefficientKey, 25)
+	configuration.Set(configuration.MutantTypeEnabledKey(mutator.InvertBitwise), true)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	module := gomodule.GoModule{Name: "cancellation.example", Root: root, CallingDir: "."}
+	baseline, err := coverage.New(logs, module, coverage.WithContext(ctx)).Run()
+	if err != nil {
+		t.Fatal(err)
+	}
+	folders := workdir.NewCachedDealer(scratch, root)
+	defer folders.Clean()
+	dealer := NewExecutorDealer(module, folders, baseline.Elapsed, WithContext(ctx), WithExpectedTests(baseline.TestCensus))
+	engine := New(module, CodeData{Cov: baseline.Profile}, dealer)
+	finished := make(chan report.Results, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		finished <- engine.Run(ctx)
+	}()
+	// Join before working-directory restoration and TempDir cleanup on every exit.
+	defer func() {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(7 * time.Second):
+			t.Error("canceled producer did not join before fixture cleanup")
+		}
+	}()
+	started := time.Now()
+	// A private cold Go cache compiles the SDK before the actual test can start.
+	// Startup is not cancellation latency; retain a bounded prerequisite allowance.
+	deadline := started.Add(120 * time.Second)
+	if enclosing, ok := t.Deadline(); ok && enclosing.Add(-15*time.Second).Before(deadline) {
+		deadline = enclosing.Add(-15 * time.Second)
+	}
+	for {
+		data, err := os.ReadFile(heartbeat)
+		if err == nil && len(data) > 0 {
+			break
+		}
+		if !time.Now().Before(deadline) {
+			cancel()
+			t.Fatal("actual active mutant did not start")
+		}
+		select {
+		case <-done:
+			t.Fatalf("producer exited before the actual test started: %v", <-finished)
+		default:
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Logf("actual test readiness after %s", time.Since(started))
+	cancel()
+	select {
+	case results := <-finished:
+		if len(results.Mutants) == 0 {
+			t.Fatal("active mutation outcome lost")
+		}
+	case <-time.After(7 * time.Second):
+		t.Fatal("worker/producer cancellation did not finish")
+	}
+	worker, err := folders.Get("mutator-0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	restored, err := os.ReadFile(filepath.Join(worker, "value.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(restored) != source {
+		t.Fatal("canceled mutation source not restored byte-for-byte")
+	}
+	before, err := os.ReadFile(heartbeat)
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	after, err := os.ReadFile(heartbeat)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Compare(string(before), string(after)) != 0 {
+		t.Fatal("active mutation test survived cancellation")
+	}
+}
