+	folder := filepath.Join(cache.Path, "00")
+	if err := os.Mkdir(folder, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	file, err := os.Create(filepath.Join(folder, strings.Repeat("0", 64)+"-d"))
