+++ b/internal/report/resolved_outcomes_test.go
@@ -0,0 +1,86 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package report_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"github.com/go-gremlins/gremlins/internal/configuration"
+	"github.com/go-gremlins/gremlins/internal/log"
+	"github.com/go-gremlins/gremlins/internal/mutator"
+	"github.com/go-gremlins/gremlins/internal/report"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestResolvedOutcomeFractionIncludesAllReportedPositions(t *testing.T) {
+	cases := []struct {
+		name            string
+		counts          map[mutator.Status]int
+		incomplete      bool
+		want            float64
+		resolved, total int
+	}{
+		{"actual aborted campaign", map[mutator.Status]int{mutator.Killed: 141, mutator.Lived: 8, mutator.NotViable: 64, mutator.ExecutionError: 2829}, false, 7.001972386587771, 213, 3042},
+		{"mixed unresolved", map[mutator.Status]int{mutator.Killed: 1, mutator.Lived: 1, mutator.NotViable: 1, mutator.ExecutionError: 1, mutator.TimedOut: 1, mutator.NotCovered: 1, mutator.Runnable: 1, mutator.Skipped: 1}, false, 37.5, 3, 8},
+		{"all infrastructure errors", map[mutator.Status]int{mutator.ExecutionError: 3}, false, 0, 0, 3},
+		{"partial reported census", map[mutator.Status]int{mutator.Killed: 1, mutator.ExecutionError: 2}, true, 33.33333333333333, 1, 3},
+		{"empty partial", nil, true, 0, 0, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			beforeDry := configuration.Get[bool](configuration.UnleashDryRunKey)
+			beforeOutput := configuration.Get[string](configuration.UnleashOutputKey)
+			defer func() {
+				configuration.Set(configuration.UnleashDryRunKey, beforeDry)
+				configuration.Set(configuration.UnleashOutputKey, beforeOutput)
+			}()
+			configuration.Set(configuration.UnleashDryRunKey, false)
+			file := filepath.Join(t.TempDir(), "report.json")
+			configuration.Set(configuration.UnleashOutputKey, file)
+			out := &bytes.Buffer{}
+			log.Init(out, &bytes.Buffer{})
+			defer log.Reset()
+			data := report.Results{Incomplete: tc.incomplete, TerminationReason: "deadline_exceeded"}
+			for status, count := range tc.counts {
+				for i := 0; i < count; i++ {
+					data.Mutants = append(data.Mutants, stubMutant{status: status, mutantType: mutator.ConditionalsNegation, position: fakePosition})
+				}
+			}
+			if !tc.incomplete {
+				data.TerminationReason = ""
+			}
+			err := report.Do(data)
+			if err == nil {
+				t.Fatal("incomplete/error campaign accepted")
+			}
+			body, err := os.ReadFile(file)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var got struct {
+				Percent  float64 `json:"mutations_coverage"`
+				Total    int     `json:"mutants_total"`
+				Complete bool    `json:"complete"`
+			}
+			if err := json.Unmarshal(body, &got); err != nil {
+				t.Fatal(err)
+			}
+			if math.Abs(got.Percent-tc.want) > 1e-9 || got.Total != tc.total || got.Complete == tc.incomplete {
+				t.Fatalf("untruthful ratio/count/header: %+v", got)
+			}
+			if !strings.Contains(out.String(), fmt.Sprintf("Resolved outcomes: %d/%d reported positions", tc.resolved, tc.total)) {
+				t.Fatal("resolved/total count missing")
+			}
+			if tc.incomplete && !strings.Contains(out.String(), "not a complete campaign census") {
+				t.Fatal("partial ratio unqualified")
+			}
+			if tc.total == 0 && !strings.Contains(out.String(), "unavailable (zero reported positions)") {
+				t.Fatal("empty ratio treated as defined")
+			}
+		})
+	}
+}
