+		{"timeout", "func TestValue(t *testing.T){select{}}", "", mutator.TimedOut},
+		{"cache-failure", "func TestValue(t *testing.T){}", "", mutator.ExecutionError},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			root := t.TempDir()
+			mustWrite(t, filepath.Join(root, "go.mod"), "module probe.example\ngo 1.27.1\n")
+			mustWrite(t, filepath.Join(root, "value.go"), "package probe\n")
