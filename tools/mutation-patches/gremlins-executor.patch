@@ -0,0 +1,49 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package workdir
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestScratchCleanupPreservesUnknownReplacement(t *testing.T) {
+	parent := t.TempDir()
+	d, err := NewScratch(parent, "owned-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := d.Path() + "-retained"
+	if err = os.Rename(d.Path(), old); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Mkdir(d.Path(), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join(d.Path(), "unknown")
+	if err = os.WriteFile(sentinel, []byte("unknown bytes"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if d.Clean() == nil {
+		t.Fatal("unknown replacement removed")
+	}
+	if b, e := os.ReadFile(sentinel); e != nil || string(b) != "unknown bytes" {
+		t.Fatal("unknown replacement changed")
+	}
+}
+func TestScratchCleanupRetainsInspectionAndCloseFailures(t *testing.T) {
+	d, err := NewScratch(t.TempDir(), "owned-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = d.pin.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = d.Clean(); !errors.Is(err, os.ErrClosed) {
+		t.Fatalf("retained handle/close fault lost: %v", err)
+	}
+	if _, err = os.Stat(d.Path()); err != nil {
+		t.Fatal("failed owner inspection removed tree")
+	}
+}
diff --git a/internal/engine/workdir/scratch_unix_test.go b/internal/engine/workdir/scratch_unix_test.go
new file mode 100644
index 0000000..654e9c7
--- /dev/null
+++ b/internal/engine/workdir/scratch_unix_test.go
@@ -0,0 +1,72 @@
+//go:build darwin || linux
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package workdir
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestScratchCleanupRestoresOwnedDirectoryModesWithoutFollowingOutsideLink(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Fatal("owned mode cleanup requires unprivileged native user")
+	}
+	for _, mode := range []os.FileMode{0o500, 0} {
+		t.Run(mode.String(), func(t *testing.T) {
+			parent := t.TempDir()
+			outside := t.TempDir()
+			t.Cleanup(func() {
+				if err := os.Chmod(outside, 0o700); err != nil {
+					t.Error(err)
+				}
+			})
+			sentinel := filepath.Join(outside, "sentinel")
+			if err := os.WriteFile(sentinel, []byte("outside unchanged"), 0o400); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Chmod(outside, 0o500); err != nil {
+				t.Fatal(err)
+			}
+			d, err := NewScratch(parent, "owned-")
+			if err != nil {
+				t.Fatal(err)
+			}
+			nested := filepath.Join(d.Path(), "nested")
+			if err = os.Mkdir(nested, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.WriteFile(filepath.Join(nested, "file"), []byte("owned"), 0o400); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.Symlink(outside, filepath.Join(d.Path(), "outside")); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.Chmod(nested, mode); err != nil {
+				t.Fatal(err)
+			}
+			if err = os.Chmod(d.Path(), mode); err != nil {
+				t.Fatal(err)
+			}
+			if err = d.Clean(); err != nil {
+				t.Fatal(err)
+			}
+			if _, err = os.Stat(d.Path()); !os.IsNotExist(err) {
+				t.Fatal("owned root retained")
+			}
+			data, err := os.ReadFile(sentinel)
+			if err != nil || string(data) != "outside unchanged" {
+				t.Fatal("outside target changed")
+			}
+			outsideInfo, err := os.Stat(outside)
+			if err != nil || outsideInfo.Mode().Perm() != 0o500 {
+				t.Fatal("outside directory permissions changed")
+			}
+			info, err := os.Stat(sentinel)
+			if err != nil || info.Mode().Perm() != 0o400 {
+				t.Fatal("outside file mode changed")
+			}
+		})
+	}
+}
