new file mode 100644
index 0000000..db5008f
--- /dev/null
+++ b/internal/engine/test_execution.go
@@ -0,0 +1,139 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package engine
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+
+	"github.com/go-gremlins/gremlins/internal/execution"
+	"github.com/go-gremlins/gremlins/internal/mutator"
+)
+
+func (m *mutantExecutor) executeJudgedTest(ctx context.Context, cmd *exec.Cmd, root string) (mutator.Status, error) {
+	if m.executionLogDir == "" {
+		return mutator.ExecutionError, errors.New("missing execution-log-dir")
+	}
+	key := fmt.Sprintf("%s:%s", m.mutant.Position(), m.mutant.Type())
+	digest := fmt.Sprintf("%x", sha256.Sum256([]byte(key)))
+	prefix := filepath.Join(m.executionLogDir, digest)
+	stdout, err := os.OpenFile(prefix+".stdout.json", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+	if err != nil {
+		return mutator.ExecutionError, fmt.Errorf("create stdout artifact: %w", err)
+	}
+	stderr, err := os.OpenFile(prefix+".stderr.txt", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+	if err != nil {
+		return mutator.ExecutionError, errors.Join(fmt.Errorf("create stderr artifact: %w", err), stdout.Close())
+	}
+	if m.cache != nil {
+		if err := m.cache.Configure(cmd); err != nil {
+			return mutator.ExecutionError, errors.Join(err, stdout.Close(), stderr.Close())
+		}
+	}
+	started := time.Now()
+	runErr, processCleanupErr, processStarted := execution.RunGoCommand(ctx, cmd, stdout, stderr)
+	finished := time.Now()
+	if m.cache != nil {
+		processCleanupErr = errors.Join(processCleanupErr, m.cache.AfterCommand(ctx, cmd, m.executionLogDir, digest))
+	}
+	_, stderrSeekErr := stderr.Seek(0, 0)
+	stderrErr := stderrSeekErr
+	if stderrErr == nil && processCleanupErr == nil {
+		stderrErr = execution.CheckInfrastructureStream(stderr)
+	}
+	var stderrHash string
+	var stderrBytes int64
+	var stderrHashErr error
+	if processCleanupErr == nil {
+		stderrHash, stderrBytes, stderrHashErr = hashRawOutput(stderr)
+	}
+	closeErr := stderr.Close()
+	_, seekErr := stdout.Seek(0, 0)
+	status, judgmentErr := mutator.ExecutionError, error(nil)
+	if seekErr == nil && processCleanupErr == nil {
+		var expected *execution.TestCensus
+		if m.expectedTests != nil {
+			census := m.expectedTests
+			if !m.integrationMode {
+				census = execution.TestCensus{}
+				if entry, ok := m.expectedTests[m.mutant.Pkg()]; ok {
+					census[m.mutant.Pkg()] = entry
+				}
+			}
+			expected = &census
+		}
+		judgment, err := execution.JudgeTestStream(stdout, root, runErr, errors.Is(ctx.Err(), context.DeadlineExceeded) && processStarted, expected)
+		status, judgmentErr = judgment.Status, err
+	}
+	var stdoutHash string
+	var stdoutBytes int64
+	var stdoutHashErr error
+	if processCleanupErr == nil {
+		stdoutHash, stdoutBytes, stdoutHashErr = hashRawOutput(stdout)
+	}
+	artifactErr := errors.Join(processCleanupErr, stderrErr, stderrHashErr, stdoutHashErr, closeErr, seekErr, stdout.Close())
+	if artifactErr != nil {
+		status = mutator.ExecutionError
+	}
+	evidence := struct {
+		Mutation        string    `json:"mutation"`
+		Status          string    `json:"judgment_status"`
+		DiscoveryStatus string    `json:"discovery_status,omitempty"`
+		Started         time.Time `json:"started"`
+		Finished        time.Time `json:"finished"`
+		ProcessError    string    `json:"process_error"`
+		JudgmentError   string    `json:"judgment_error"`
+		ArtifactError   string    `json:"artifact_error"`
+		GoStarted       bool      `json:"go_started"`
+		StdoutSHA256    string    `json:"stdout_sha256"`
+		StdoutBytes     int64     `json:"stdout_bytes"`
+		StderrSHA256    string    `json:"stderr_sha256"`
+		StderrBytes     int64     `json:"stderr_bytes"`
+		CachePolicy     string    `json:"cache_policy"`
+	}{Mutation: key, Status: status.String(), GoStarted: processStarted, StdoutSHA256: stdoutHash, StdoutBytes: stdoutBytes, StderrSHA256: stderrHash, StderrBytes: stderrBytes, CachePolicy: "Go test source/input-keyed cache enabled; named events may be cached replay", Started: started, Finished: finished, ProcessError: errorText(runErr), JudgmentError: errorText(judgmentErr), ArtifactError: errorText(artifactErr)}
+	if original, ok := m.mutant.(interface{ DiscoveryStatus() (mutator.Status, bool) }); ok {
+		if status, present := original.DiscoveryStatus(); present {
+			evidence.DiscoveryStatus = status.String()
+		}
+	}
+	data, encodeErr := json.MarshalIndent(evidence, "", "  ")
+	result, resultErr := os.OpenFile(prefix+".result.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if resultErr == nil {
+		_, writeErr := result.Write(data)
+		resultErr = errors.Join(writeErr, result.Close())
+	}
+	if encodeErr == nil && resultErr == nil {
+		if binding, ok := m.mutant.(interface{ SetExecutionReference(string) }); ok {
+			binding.SetExecutionReference(digest)
+		}
+	}
+	if encodeErr != nil || resultErr != nil {
+		status = mutator.ExecutionError
+	}
+	return status, errors.Join(judgmentErr, artifactErr, encodeErr, resultErr)
+}
+func errorText(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
+
+func hashRawOutput(file *os.File) (string, int64, error) {
+	if _, err := file.Seek(0, 0); err != nil {
+		return "", 0, err
+	}
+	hash := sha256.New()
+	count, err := io.Copy(hash, file)
+	if err != nil {
+		return "", count, err
+	}
+	return fmt.Sprintf("%x", hash.Sum(nil)), count, nil
+}
