index 0000000..1f483f5
--- /dev/null
+++ b/internal/execution/go_process_unix.go
@@ -0,0 +1,130 @@
+//go:build darwin || linux
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"sync"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const goCommandCleanupBudget = 5 * time.Second
+
+// RunGoCommand owns the private process group until all signalling finishes,
+// before Wait reaps its leader and permits numeric PID reuse.
+func RunGoCommand(ctx context.Context, cmd *exec.Cmd, stdout, stderr *os.File) (error, error, bool) {
+	return runPOSIXTestProcess(ctx, cmd, stdout, stderr, unix.Kill)
+}
+func runPOSIXTestProcess(ctx context.Context, cmd *exec.Cmd, stdout, stderr *os.File, signalGroup func(int, syscall.Signal) error) (error, error, bool) {
+	if cmd.SysProcAttr != nil {
+		return errors.New("test command must not provide custom process attributes"), nil, false
+	}
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	outPipe, err := cmd.StdoutPipe()
+	if err != nil {
+		return err, nil, false
+	}
+	errPipe, err := cmd.StderrPipe()
+	if err != nil {
+		return err, outPipe.Close(), false
+	}
+	var ownership sync.Mutex
+	closed := false
+	var cleanupDeadline time.Time
+	killGroup := func() error {
+		if cmd.Process == nil {
+			return os.ErrProcessDone
+		}
+		if cleanupDeadline.IsZero() {
+			cleanupDeadline = time.Now().Add(goCommandCleanupBudget)
+		}
+		err := signalGroup(-cmd.Process.Pid, unix.SIGKILL)
+		if errors.Is(err, unix.ESRCH) {
+			return nil
+		}
+		return normalizeGroupKillError(cmd.Process.Pid, err, cleanupDeadline)
+	}
+	if cmd.Cancel != nil {
+		cmd.Cancel = func() error {
+			ownership.Lock()
+			defer ownership.Unlock()
+			if closed {
+				return os.ErrProcessDone
+			}
+			return killGroup()
+		}
+	}
+	if err := cmd.Start(); err != nil {
+		ownership.Lock()
+		closed = true
+		ownership.Unlock()
+		return err, errors.Join(outPipe.Close(), errPipe.Close()), false
+	}
+	copied := make(chan error, 2)
+	drain := func(destination io.Writer, source io.Reader) {
+		_, copyErr := io.Copy(destination, source)
+		if copyErr != nil {
+			_, drainErr := io.Copy(io.Discard, source)
+			copyErr = errors.Join(copyErr, drainErr)
+		}
+		copied <- copyErr
+	}
+	go drain(stdout, outPipe)
+	go drain(stderr, errPipe)
+	finishedCopies := 0
+	var copyErr error
+	for finishedCopies < 2 {
+		select {
+		case err := <-copied:
+			copyErr = errors.Join(copyErr, err)
+			finishedCopies++
+		case <-ctx.Done():
+			goto terminate
+		}
+	}
+terminate:
+	// Both the normal EOF and cancellation paths terminate leftover group members.
+	// The leader has not been reaped, including when it already exited normally.
+	ownership.Lock()
+	killErr := killGroup()
+	if killErr != nil {
+		killErr = errors.Join(killErr, cmd.Process.Kill())
+	}
+	closed = true
+	ownership.Unlock()
+	deadline := time.NewTimer(time.Until(cleanupDeadline))
+	defer deadline.Stop()
+
+	var readerErr error
+	readersClosed := false
+	for finishedCopies < 2 {
+		select {
+		case err := <-copied:
+			copyErr = errors.Join(copyErr, err)
+			finishedCopies++
+		case <-deadline.C:
+			if readersClosed {
+				readerErr = errors.Join(readerErr, errors.New("output copy workers did not join after closing owned readers"))
+				goto reap
+			}
+			readerErr = errors.Join(readerErr, errors.New("test output writers persisted after owned group termination"), outPipe.Close(), errPipe.Close())
+			readersClosed = true
+			deadline.Reset(time.Second)
+		}
+	}
+reap:
+	if !readersClosed {
+		readerErr = errors.Join(readerErr, outPipe.Close(), errPipe.Close())
+	}
+
+	waitErr := cmd.Wait()
+	return errors.Join(waitErr, ctx.Err()), errors.Join(killErr, copyErr, readerErr), true
+}
diff --git a/internal/execution/go_process_unix_test.go b/internal/execution/go_process_unix_test.go
new file mode 100644
index 0000000..d986328
--- /dev/null
+++ b/internal/execution/go_process_unix_test.go
@@ -0,0 +1,149 @@
+//go:build darwin || linux
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"errors"
+	"golang.org/x/sys/unix"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestOwnedProcessHelper(t *testing.T) {
+	role := os.Getenv("GREMLINS_PROCESS_HELPER")
+	if role == "" {
+		return
+	}
+	if role == "child" {
+		if err := os.WriteFile(os.Getenv("GREMLINS_CHILD_PID"), []byte(strconv.Itoa(os.Getpid())), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			if err := os.WriteFile(os.Getenv("GREMLINS_HEARTBEAT"), []byte(time.Now().String()), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(executable, "-test.run=^TestOwnedProcessHelper$")
+	child.Env = append(os.Environ(), "GREMLINS_PROCESS_HELPER=child")
+	discard, err := os.OpenFile(os.DevNull, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer discard.Close()
+	child.Stdout = discard
+	child.Stderr = discard
+	if err := child.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if !waitForHeartbeat(os.Getenv("GREMLINS_HEARTBEAT"), 5*time.Second) {
+		_ = child.Process.Kill()
+		_ = child.Wait()
+		t.Fatal("child never became active")
+	}
+	if role == "timeout" {
+		for {
+			time.Sleep(time.Second)
+		}
+	}
+	// Deliberately return without waiting for the silent descendant.
+}
+func waitForHeartbeat(path string, budget time.Duration) bool {
+	deadline := time.Now().Add(budget)
+	for time.Now().Before(deadline) {
+		if data, err := os.ReadFile(path); err == nil && len(data) > 0 {
+			return true
+		}
+		time.Sleep(time.Millisecond)
+	}
+	return false
+}
+func TestOwnedProcessStopsSilentDescendantsBeforeReturn(t *testing.T) {
+	for _, mode := range []string{"normal", "timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			directory := t.TempDir()
+			heartbeat := filepath.Join(directory, "heartbeat")
+			pid := filepath.Join(directory, "child.pid")
+			executable, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			cmd := exec.CommandContext(ctx, executable, "-test.run=^TestOwnedProcessHelper$")
+			cmd.Env = append(os.Environ(), "GREMLINS_PROCESS_HELPER="+mode, "GREMLINS_CHILD_PID="+pid, "GREMLINS_HEARTBEAT="+heartbeat)
+			out, err := os.Create(filepath.Join(directory, "stdout"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer out.Close()
+			stderr, err := os.Create(filepath.Join(directory, "stderr"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer stderr.Close()
+			var signals atomic.Int32
+			signalGroup := func(pid int, signal syscall.Signal) error { signals.Add(1); return unix.Kill(pid, signal) }
+			finished := make(chan error, 1)
+			go func() {
+				runErr, cleanupErr, started := runPOSIXTestProcess(ctx, cmd, out, stderr, signalGroup)
+				if !started {
+					finished <- errors.New("helper not started")
+					return
+				}
+				if mode == "normal" {
+					cleanupErr = errors.Join(cleanupErr, runErr)
+				}
+				finished <- cleanupErr
+			}()
+			if !waitForHeartbeat(heartbeat, 5*time.Second) {
+				cancel()
+				t.Fatal("descendant was not actually active")
+			}
+			if mode == "timeout" {
+				cancel()
+			}
+			select {
+			case err := <-finished:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(7 * time.Second):
+				cancel()
+				t.Fatal("process cleanup did not finish")
+			}
+			before, err := os.ReadFile(heartbeat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			time.Sleep(50 * time.Millisecond)
+			after, err := os.ReadFile(heartbeat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(before) != string(after) {
+				t.Fatal("silent descendant remained active after return")
+			}
+			calls := signals.Load()
+			if err := cmd.Cancel(); !errors.Is(err, os.ErrProcessDone) {
+				t.Fatalf("late cancel: %v", err)
+			}
+			if signals.Load() != calls {
+				t.Fatal("late cancellation signalled a reaped leader/group")
+			}
+		})
+	}
+}
diff --git a/internal/execution/go_process_windows.go b/internal/execution/go_process_windows.go
new file mode 100644
index 0000000..63d4730
--- /dev/null
+++ b/internal/execution/go_process_windows.go
@@ -0,0 +1,192 @@
+//go:build windows
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"runtime"
+	"time"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type ownedProcessExit struct{ code int }
+
+func (e ownedProcessExit) Error() string { return fmt.Sprintf("Go test exit status %d", e.code) }
+func (e ownedProcessExit) ExitCode() int { return e.code }
+
+// Layout from JOBOBJECT_BASIC_ACCOUNTING_INFORMATION in the Windows SDK.
+type jobAccounting struct {
+	TotalUserTime, TotalKernelTime, ThisPeriodUserTime, ThisPeriodKernelTime       int64
+	TotalPageFaultCount, TotalProcesses, ActiveProcesses, TotalTerminatedProcesses uint32
+}
+
+func windowsEnvironment(entries []string) ([]uint16, error) {
+	var block []uint16
+	for _, entry := range entries {
+		encoded, err := windows.UTF16FromString(entry)
+		if err != nil {
+			return nil, err
+		}
+		block = append(block, encoded...)
+	}
+	block = append(block, 0)
+	if len(block) == 1 {
+		block = append(block, 0)
+	}
+	return block, nil
+}
+
+// The command is suspended until its private job and explicit stdio whitelist
+// are installed. No process is reopened by PID; owned handles identify it.
+func RunGoCommand(ctx context.Context, cmd *exec.Cmd, stdout, stderr *os.File) (runErr, cleanupErr error, started bool) {
+	if cmd.Err != nil {
+		return cmd.Err, nil, false
+	}
+	if cmd.Stdin != nil || cmd.SysProcAttr != nil {
+		return errors.New("test command must not provide custom stdin or process attributes"), nil, false
+	}
+	if err := ctx.Err(); err != nil {
+		return err, nil, false
+	}
+	job, err := windows.CreateJobObject(nil, nil)
+	if err != nil {
+		return err, nil, false
+	}
+	defer func() { cleanupErr = errors.Join(cleanupErr, windows.CloseHandle(job)) }()
+	limits := windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION{}
+	limits.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+	if _, err := windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&limits)), uint32(unsafe.Sizeof(limits))); err != nil {
+		return err, nil, false
+	}
+	input, err := os.Open(os.DevNull)
+	if err != nil {
+		return err, nil, false
+	}
+	defer func() { cleanupErr = errors.Join(cleanupErr, input.Close()) }()
+	current := windows.CurrentProcess()
+	handles := make([]windows.Handle, 3)
+	for i, file := range []*os.File{input, stdout, stderr} {
+		if err := windows.DuplicateHandle(current, windows.Handle(file.Fd()), current, &handles[i], 0, true, windows.DUPLICATE_SAME_ACCESS); err != nil {
+			return err, nil, false
+		}
+		index := i
+		defer func() { cleanupErr = errors.Join(cleanupErr, windows.CloseHandle(handles[index])) }()
+	}
+	attributes, err := windows.NewProcThreadAttributeList(1)
+	if err != nil {
+		return err, nil, false
+	}
+	defer attributes.Delete()
+	if err := attributes.Update(windows.PROC_THREAD_ATTRIBUTE_HANDLE_LIST, unsafe.Pointer(&handles[0]), uintptr(len(handles))*unsafe.Sizeof(handles[0])); err != nil {
+		return err, nil, false
+	}
+	application, err := windows.UTF16PtrFromString(cmd.Path)
+	if err != nil {
+		return err, nil, false
+	}
+	commandLine, err := windows.UTF16PtrFromString(windows.ComposeCommandLine(cmd.Args))
+	if err != nil {
+		return err, nil, false
+	}
+	var directory *uint16
+	if cmd.Dir != "" {
+		directory, err = windows.UTF16PtrFromString(cmd.Dir)
+		if err != nil {
+			return err, nil, false
+		}
+	}
+	environment, err := windowsEnvironment(cmd.Environ())
+	if err != nil {
+		return err, nil, false
+	}
+	startup := windows.StartupInfoEx{}
+	startup.Cb = uint32(unsafe.Sizeof(startup))
+	startup.Flags = windows.STARTF_USESTDHANDLES
+	startup.StdInput = handles[0]
+	startup.StdOutput = handles[1]
+	startup.StdErr = handles[2]
+	startup.ProcThreadAttributeList = attributes.List()
+	var process windows.ProcessInformation
+	flags := uint32(windows.CREATE_SUSPENDED | windows.CREATE_UNICODE_ENVIRONMENT | windows.EXTENDED_STARTUPINFO_PRESENT)
+	if err := windows.CreateProcess(application, commandLine, nil, nil, true, flags, &environment[0], directory, &startup.StartupInfo, &process); err != nil {
+		return err, nil, false
+	}
+	runtime.KeepAlive(handles)
+	runtime.KeepAlive(environment)
+	runtime.KeepAlive(attributes)
+	defer func() {
+		cleanupErr = errors.Join(cleanupErr, windows.CloseHandle(process.Thread), windows.CloseHandle(process.Process))
+	}()
+	if err := windows.AssignProcessToJobObject(job, process.Process); err != nil {
+		// It cannot have created descendants while still suspended and unassigned.
+		killErr := windows.TerminateProcess(process.Process, 1)
+		state, waitErr := windows.WaitForSingleObject(process.Process, 5000)
+		if waitErr == nil && state != windows.WAIT_OBJECT_0 {
+			waitErr = fmt.Errorf("suspended process cleanup wait returned %d", state)
+		}
+		return err, errors.Join(killErr, waitErr), false
+	}
+	if previous, err := windows.ResumeThread(process.Thread); err != nil || previous != 1 {
+		if err == nil {
+			err = fmt.Errorf("unexpected suspended thread count %d", previous)
+		}
+		cleanupErr = stopWindowsJob(job)
+		return err, cleanupErr, false
+	}
+	started = true
+	var code uint32
+	for {
+		state, waitErr := windows.WaitForSingleObject(process.Process, 20)
+		if waitErr != nil {
+			runErr = waitErr
+			break
+		}
+		if state == windows.WAIT_OBJECT_0 {
+			if err := windows.GetExitCodeProcess(process.Process, &code); err != nil {
+				runErr = err
+			} else if code != 0 {
+				runErr = ownedProcessExit{int(code)}
+			}
+			break
+		}
+		if state != uint32(windows.WAIT_TIMEOUT) {
+			runErr = fmt.Errorf("unknown owned process wait result %d", state)
+			break
+		}
+		if err := ctx.Err(); err != nil {
+			runErr = err
+			break
+		}
+	}
+	cleanupErr = stopWindowsJob(job)
+	return runErr, cleanupErr, true
+}
+func stopWindowsJob(job windows.Handle) error {
+	terminateErr := windows.TerminateJobObject(job, 1)
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		var facts jobAccounting
+		var returned uint32
+		queryErr := windows.QueryInformationJobObject(job, windows.JobObjectBasicAccountingInformation, uintptr(unsafe.Pointer(&facts)), uint32(unsafe.Sizeof(facts)), &returned)
+		if queryErr != nil {
+			return errors.Join(terminateErr, queryErr)
+		}
+		if returned != uint32(unsafe.Sizeof(facts)) {
+			return errors.Join(terminateErr, errors.New("unexpected owned job accounting length"))
+		}
+		if facts.ActiveProcesses == 0 {
+			return terminateErr
+		}
+		if !time.Now().Before(deadline) {
+			return errors.Join(terminateErr, errors.New("owned job processes persisted after termination"))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
