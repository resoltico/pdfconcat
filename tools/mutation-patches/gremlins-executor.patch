+	beforeLog := configuration.Get[string](configuration.UnleashExecutionLogDirKey)
+	defer func() {
+		configuration.Set(configuration.UnleashRunUncoveredKey, beforeRun)
+		configuration.Set(configuration.UnleashWorkersKey, beforeWorkers)
+		configuration.Set(configuration.UnleashIntegrationMode, beforeIntegration)
+		configuration.Set(configuration.MutantTypeEnabledKey(mutator.InvertBitwise), beforeOperator)
+		configuration.Set(configuration.UnleashExecutionLogDirKey, beforeLog)
+	}()
+	root := t.TempDir()
+	scratch := t.TempDir()
+	logs := t.TempDir()
+	markers := t.TempDir()
+	source := "package deadline\n"
+	for i := 0; i < 64; i++ {
+		source += fmt.Sprintf("const Bound%d = 1 << 2\n", i)
+	}
+	mustWrite(t, filepath.Join(root, "value.go"), source)
+	configuration.Set(configuration.UnleashRunUncoveredKey, true)
+	configuration.Set(configuration.UnleashWorkersKey, 4)
+	configuration.Set(configuration.UnleashIntegrationMode, true)
+	configuration.Set(configuration.MutantTypeEnabledKey(mutator.InvertBitwise), true)
+	configuration.Set(configuration.UnleashExecutionLogDirKey, logs)
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	factory := func(ctx context.Context, _ string, _ ...string) *exec.Cmd {
+		cmd := exec.CommandContext(ctx, executable, "-test.run=^TestDeadlineProcessHelper$")
+		cmd.Env = append(os.Environ(), "GREMLINS_DEADLINE_HELPER=1", "GREMLINS_DEADLINE_MARKERS="+markers)
+		return cmd
+	}
+	folders := workdir.NewCachedDealer(scratch, root)
+	defer folders.Clean()
+	module := gomodule.GoModule{Name: "deadline.example", Root: root, CallingDir: "."}
+	dealer := NewExecutorDealer(module, folders, time.Minute, WithContext(ctx), WithExecContext(factory))
+	engine := New(module, CodeData{}, dealer)
+	finished := make(chan report.Results, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		finished <- engine.Run(ctx)
+	}()
+	// Join before working-directory restoration and TempDir cleanup on every exit.
+	defer func() {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(7 * time.Second):
+			t.Error("canceled producer did not join before fixture cleanup")
+		}
+	}()
+	ready := false
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		entries, err := os.ReadDir(markers)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(entries) == 2 {
+			ready = true
+			break
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if !ready {
+		cancel()
+		t.Fatal("two real worker processes were not active")
+	}
+	select {
+	case result := <-finished:
+		if !result.Incomplete || result.TerminationReason != "deadline_exceeded" || len(result.Mutants) < 2 {
+			t.Fatalf("deadline facts lost: %+v", result)
+		}
+	case <-time.After(7 * time.Second):
+		t.Fatal("deadline drain did not finish")
+	}
+	for i := 0; i < 2; i++ {
+		worker, err := folders.Get(fmt.Sprintf("mutator-%d", i))
+		if err != nil {
+			t.Fatal(err)
+		}
+		data, err := os.ReadFile(filepath.Join(worker, "value.go"))
+		if err != nil || string(data) != source {
+			t.Fatal("deadline source restoration failed")
+		}
+	}
+	entries, err := os.ReadDir(markers)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := map[string]string{}
+	for _, entry := range entries {
+		data, err := os.ReadFile(filepath.Join(markers, entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		before[entry.Name()] = string(data)
+	}
+	time.Sleep(50 * time.Millisecond)
+	for name, data := range before {
+		now, err := os.ReadFile(filepath.Join(markers, name))
+		if err != nil || string(now) != data {
+			t.Fatal("owned deadline process survived drain")
+		}
+	}
+}
