+//go:build windows
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/windows"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+	"unsafe"
+)
+
+func TestOwnedWindowsProcessHelper(t *testing.T) {
+	role := os.Getenv("GREMLINS_PROCESS_HELPER")
+	if role == "" {
+		return
+	}
+	if role == "child" {
+		for {
+			if err := os.WriteFile(os.Getenv("GREMLINS_HEARTBEAT"), []byte(time.Now().String()), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected, err := strconv.ParseUint(os.Getenv("GREMLINS_EXCLUDED_HANDLE"), 10, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var inherited uint32
+	getInfo := windows.NewLazySystemDLL("kernel32.dll").NewProc("GetHandleInformation")
+	ok, _, infoErr := getInfo.Call(uintptr(expected), uintptr(unsafe.Pointer(&inherited)))
+	if ok == 0 && infoErr != windows.ERROR_INVALID_HANDLE {
+		t.Fatalf("unknown handle-whitelist observation: %v", infoErr)
+	}
+	record := struct {
+		CWD, Value            string
+		Args                  []string
+		UnexpectedInheritance bool
+	}{CWD: cwd, Value: os.Getenv("GREMLINS_ENV_VALUE"), Args: os.Args, UnexpectedInheritance: ok != 0 && inherited&windows.HANDLE_FLAG_INHERIT != 0}
+	data, err := json.Marshal(record)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(os.Getenv("GREMLINS_HELPER_RECORD"), data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command(executable, "-test.run=^TestOwnedWindowsProcessHelper$")
+	child.Env = append(os.Environ(), "GREMLINS_PROCESS_HELPER=child")
+	discard, err := os.OpenFile(os.DevNull, os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer discard.Close()
+	child.Stdout = discard
+	child.Stderr = discard
+	if err := child.Start(); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if data, err := os.ReadFile(os.Getenv("GREMLINS_HEARTBEAT")); err == nil && len(data) > 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			_ = child.Process.Kill()
+			_ = child.Wait()
+			t.Fatal("descendant not started")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if role == "timeout" {
+		for {
+			time.Sleep(time.Second)
+		}
+	}
+}
+func TestOwnedWindowsJobStopsDescendantsAndPreservesEncoding(t *testing.T) {
+	for _, mode := range []string{"normal", "timeout"} {
+		t.Run(mode, func(t *testing.T) {
+			directory := filepath.Join(t.TempDir(), "spaces Ā Ελληνικά")
+			if err := os.Mkdir(directory, 0o700); err != nil {
+				t.Fatal(err)
+			}
+			heartbeat := filepath.Join(directory, "heartbeat")
+			record := filepath.Join(directory, "record.json")
+			security := windows.SecurityAttributes{Length: uint32(unsafe.Sizeof(windows.SecurityAttributes{})), InheritHandle: 1}
+			excluded, err := windows.CreateEvent(&security, 1, 0, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer windows.CloseHandle(excluded)
+			executable, err := os.Executable()
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			argument := `spaces "quotes" backslash\ Ελληνικά`
+			cmd := exec.CommandContext(ctx, executable, "-test.run=^TestOwnedWindowsProcessHelper$", "--", argument)
+			cmd.Dir = directory
+			cmd.Env = append(os.Environ(), "GREMLINS_PROCESS_HELPER="+mode, "GREMLINS_HEARTBEAT="+heartbeat, "GREMLINS_HELPER_RECORD="+record, "GREMLINS_ENV_VALUE=Ā Ελληνικά", fmt.Sprintf("GREMLINS_EXCLUDED_HANDLE=%d", excluded))
+			out, err := os.Create(filepath.Join(directory, "stdout"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer out.Close()
+			stderr, err := os.Create(filepath.Join(directory, "stderr"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer stderr.Close()
+			finished := make(chan error, 1)
+			go func() {
+				runErr, cleanupErr, started := RunGoCommand(ctx, cmd, out, stderr)
+				if !started {
+					finished <- errors.New("process not started")
+					return
+				}
+				if mode == "normal" {
+					cleanupErr = errors.Join(cleanupErr, runErr)
+				}
+				finished <- cleanupErr
+			}()
+			deadline := time.Now().Add(10 * time.Second)
+			for {
+				if data, err := os.ReadFile(heartbeat); err == nil && len(data) > 0 {
+					break
+				}
+				if time.Now().After(deadline) {
+					cancel()
+					t.Fatal("actual descendant never started")
+				}
+				time.Sleep(time.Millisecond)
+			}
+			if mode == "timeout" {
+				cancel()
+			}
+			select {
+			case err := <-finished:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(7 * time.Second):
+				cancel()
+				t.Fatal("job cleanup did not finish")
+			}
+			before, err := os.ReadFile(heartbeat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			time.Sleep(50 * time.Millisecond)
+			after, err := os.ReadFile(heartbeat)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(before) != string(after) {
+				t.Fatal("descendant survived job termination")
+			}
+			data, err := os.ReadFile(record)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var facts struct {
+				CWD, Value            string
+				Args                  []string
+				UnexpectedInheritance bool
+			}
+			if err := json.Unmarshal(data, &facts); err != nil {
+				t.Fatal(err)
+			}
+			if facts.CWD != directory || facts.Value != "Ā Ελληνικά" || len(facts.Args) == 0 || facts.Args[len(facts.Args)-1] != argument || facts.UnexpectedInheritance {
+				t.Fatalf("SDK encoding/whitelist changed: %+v", facts)
+			}
+		})
+	}
+}
