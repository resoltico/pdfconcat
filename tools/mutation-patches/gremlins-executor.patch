+	}
+	if err := file.Truncate(GoCacheBudgetBytes + 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("go", "env", "GOCACHE", "GOCACHEPROG")
+	if err := cache.Configure(cmd); err != nil {
+		t.Fatal(err)
+	}
+	data, err := cmd.Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != cache.Path+"\n\n" {
+		t.Fatalf("owned cache env mismatch: %q", data)
+	}
+	logs := t.TempDir()
+	if err := cache.AfterCommand(context.Background(), cmd, logs, "threshold"); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile(filepath.Join(logs, "threshold.cache.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var receipt struct {
+		BudgetBytes, AfterCommandBytes, AfterTrimBytes int64
+		Trimmed                                        bool
+	}
+	if err := json.Unmarshal(raw, &receipt); err != nil {
+		t.Fatal(err)
+	}
