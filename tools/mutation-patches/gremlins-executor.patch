+)
+
+type directDealer struct{ root string }
+
+func (d directDealer) Get(string) (string, error) { return d.root, nil }
+func (d directDealer) WorkDir() string            { return d.root }
+func (d directDealer) Clean() error               { return nil }
+
+type faultFileMutant struct {
+	mutator.Mutator
+	root                      string
+	status                    mutator.Status
+	applyFault, rollbackFault bool
+	applied                   bool
+}
+
+func (m *faultFileMutant) Position() token.Position {
+	return token.Position{Filename: "value.go", Line: 1, Column: 1}
+}
+func (m *faultFileMutant) Type() mutator.Type         { return mutator.ConditionalsBoundary }
+func (m *faultFileMutant) Status() mutator.Status     { return m.status }
+func (m *faultFileMutant) SetStatus(s mutator.Status) { m.status = s }
+func (m *faultFileMutant) SetWorkdir(root string)     { m.root = root }
+func (m *faultFileMutant) Workdir() string            { return m.root }
+func (m *faultFileMutant) Pkg() string                { return "./..." }
+func (m *faultFileMutant) Apply() error {
+	m.applied = true
+	if m.applyFault {
+		if err := os.WriteFile(filepath.Join(m.root, "value.go"), []byte("partial changed source"), 0o600); err != nil {
+			return err
+		}
+		_, err := os.Open(filepath.Join(m.root, "missing"))
+		return err
+	}
+	return nil
+}
+func (m *faultFileMutant) Rollback() error {
+	if !m.rollbackFault {
+		return nil
+	}
+	path := filepath.Join(m.root, "value.go")
+	if err := os.Remove(path); err != nil {
+		return err
+	}
+	if err := os.Mkdir(path, 0o700); err != nil {
+		return err
+	}
+	return os.WriteFile(path, []byte("original"), 0o600)
+}
+func TestWorkerIntegrityAfterFilesystemMutationFailure(t *testing.T) {
+	for _, kind := range []string{"apply", "rollback"} {
+		t.Run(kind, func(t *testing.T) {
+			root := t.TempDir()
+			mustWrite(t, filepath.Join(root, "go.mod"), "module probe.example\ngo 1.27.1\n")
+			mustWrite(t, filepath.Join(root, "value.go"), "package probe\n")
+			mustWrite(t, filepath.Join(root, "value_test.go"), "package probe\nimport \"testing\"\nfunc TestValue(t *testing.T){}\n")
+			worker := workerpool.NewWorker(1, "integrity")
+			counter := 0
+			run := func(ctx context.Context, name string, args ...string) *exec.Cmd {
+				counter++
+				return exec.CommandContext(ctx, name, args...)
+			}
+			first := &faultFileMutant{status: mutator.Runnable, applyFault: kind == "apply", rollbackFault: kind == "rollback"}
+			for i, m := range []*faultFileMutant{first, {status: mutator.Runnable}} {
+				out := make(chan mutator.Mutator, 1)
+				wg := &sync.WaitGroup{}
+				wg.Add(1)
+				executor := mutantExecutor{mutant: m, wdDealer: directDealer{root}, outCh: out, wg: wg, execContext: run, testExecutionTime: 30 * time.Second, executionLogDir: t.TempDir()}
+				executor.Start(worker)
+				wg.Wait()
+				result := <-out
+				if result.Status() != mutator.ExecutionError {
+					t.Fatalf("%d result %s", i, result.Status())
+				}
+				if i == 1 && m.applied {
+					t.Fatal("applied another mutant on invalid worker tree")
+				}
+			}
+			expected := 0
+			if kind == "rollback" {
+				expected = 1
+			}
+			if counter != expected || !worker.Invalid {
+				t.Fatalf("test calls %d want %d, invalid=%v", counter, expected, worker.Invalid)
+			}
+		})
+	}
+}
