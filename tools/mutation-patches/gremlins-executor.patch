+package coverage
+
+import (
+	"github.com/go-gremlins/gremlins/internal/configuration"
+	"github.com/go-gremlins/gremlins/internal/gomodule"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestExplicitBaselinePackageRejectsIncompatibleScope(t *testing.T) {
+	defer configuration.Set(configuration.UnleashBaselinePackageKey, "")
+	for _, selected := range []string{"./", "./.", "./..", "../pkg", "/pkg", "./../pkg", "./pkg/...", "./pkg/../other", "./pkg\\other", "./pkg:other"} {
+		configuration.Set(configuration.UnleashBaselinePackageKey, selected)
+		c := &Coverage{mod: gomodule.GoModule{CallingDir: "."}}
+		if _, err := c.baselinePath(); err == nil {
+			t.Fatalf("unsafe baseline accepted: %q", selected)
+		}
+	}
+	configuration.Set(configuration.UnleashBaselinePackageKey, "./internal/observation")
+	for _, c := range []*Coverage{{integrationMode: true, mod: gomodule.GoModule{CallingDir: "."}}, {mod: gomodule.GoModule{CallingDir: "internal/observation"}}} {
+		if _, err := c.baselinePath(); err == nil {
+			t.Fatal("incompatible explicit baseline accepted")
+		}
+	}
+	root := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, "internal", "observation"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	c := &Coverage{mod: gomodule.GoModule{Root: root, CallingDir: "."}}
+	if path, err := c.baselinePath(); err != nil || path != "./internal/observation" {
+		t.Fatalf("package baseline: %q %v", path, err)
+	}
+	configuration.Set(configuration.UnleashBaselinePackageKey, "")
+	if path, err := c.baselinePath(); err != nil || path != "./..." {
+		t.Fatalf("default baseline changed: %q %v", path, err)
+	}
+}
+
+func TestSelectedBaselineRunsRealPackageAndPreservesFailure(t *testing.T) {
+	defer configuration.Set(configuration.UnleashBaselinePackageKey, "")
+	defer configuration.Set(configuration.UnleashExecutionLogDirKey, "")
+	defer configuration.Set(configuration.UnleashIntegrationMode, false)
+	root := t.TempDir()
+	t.Chdir(root)
+	files := map[string]string{
+		"go.mod":                    "module baselinefixture.local\ngo 1.27.2\n",
+		"selected/guard.go":         "package selected\nfunc Guard(n int)bool{return n>0}\n",
+		"selected/guard_test.go":    "package selected\nimport \"testing\"\nfunc TestGuard(t *testing.T){if !Guard(1){t.Fatal(\"guard\")}}\n",
+		"unrelated/failure_test.go": "package unrelated\nimport \"testing\"\nfunc TestFailure(t *testing.T){t.Fatal(\"unrelated failure\")}\n",
+	}
+	for name, body := range files {
+		path := filepath.Join(root, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(body), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	module, err := gomodule.Init(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	configuration.Set(configuration.UnleashIntegrationMode, false)
+	for _, selector := range []string{"./selected/guard_test.go", "./missing"} {
+		configuration.Set(configuration.UnleashBaselinePackageKey, selector)
+		artifacts := t.TempDir()
+		configuration.Set(configuration.UnleashExecutionLogDirKey, artifacts)
+		if _, err := New(t.TempDir(), module).Run(); err == nil {
+			t.Fatalf("invalid directory selector accepted: %q", selector)
+		}
+		entries, err := os.ReadDir(artifacts)
+		if err != nil || len(entries) != 0 {
+			t.Fatalf("invalid selector launched setup: %v %v", entries, err)
+		}
+	}
+	configuration.Set(configuration.UnleashBaselinePackageKey, "./selected")
+	configuration.Set(configuration.UnleashExecutionLogDirKey, t.TempDir())
+	if _, err := New(t.TempDir(), module).Run(); err != nil {
+		t.Fatalf("unrelated failing package poisoned selected baseline: %v", err)
+	}
+	configuration.Set(configuration.UnleashBaselinePackageKey, "./unrelated")
+	configuration.Set(configuration.UnleashExecutionLogDirKey, t.TempDir())
+	if _, err := New(t.TempDir(), module).Run(); err == nil {
+		t.Fatal("selected failing package accepted")
+	}
+}
