+++ b/internal/execution/process_group_darwin.go
@@ -0,0 +1,119 @@
+//go:build darwin
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"strings"
+	"time"
+)
+
+// Darwin sys/proc.h defines SIDL=1, SRUN=2, SSLEEP=3, SSTOP=4 and immutable SZOMB=5.
+const darwinZombieState = 5
+
+// P_WEXIT is the irreversible kernel exit transition exposed by Darwin sys/proc.h.
+const darwinProcessExitingFlag = 0x2000
+
+func normalizeGroupKillError(pid int, err error, deadline time.Time) error {
+	if !errors.Is(err, unix.EPERM) {
+		return err
+	}
+	return proveOwnedGroupTermination(pid, err, deadline, func() ([]unix.KinfoProc, error) { return unix.SysctlKinfoProcSlice("kern.proc.pgrp", pid) })
+}
+
+func proveOwnedGroupTermination(pid int, signalErr error, deadline time.Time, query func() ([]unix.KinfoProc, error)) error {
+	// Cleanup must still finish after work cancellation. The unreaped leader pins authority.
+	cleanup, cancel := context.WithDeadline(context.Background(), deadline)
+	defer cancel()
+	return waitForZombieGroup(cleanup, pid, signalErr, query)
+}
+
+func waitForZombieGroup(ctx context.Context, pid int, signalErr error, query func() ([]unix.KinfoProc, error)) error {
+	started := time.Now()
+	attempts := 0
+	var last []unix.KinfoProc
+	failure := func(cause error) error {
+		return errors.Join(signalErr, fmt.Errorf("owned zombie proof after %d queries in %s (members=%d sample=%s): %w", attempts, time.Since(started), len(last), boundedGroupState(last), cause))
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return failure(err)
+		}
+		group, err := query()
+		attempts++
+		last = group
+		if err != nil {
+			return failure(fmt.Errorf("query owned process group: %w", err))
+		}
+		zombie, err := zombieGroupState(pid, group)
+		if err != nil {
+			return failure(err)
+		}
+		if err := ctx.Err(); err != nil {
+			return failure(err)
+		}
+		if zombie {
+			return nil
+		}
+		timer := time.NewTimer(time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return failure(ctx.Err())
+		case <-timer.C:
+		}
+	}
+}
+func boundedGroupState(group []unix.KinfoProc) string {
+	var sample []string
+	for i, member := range group {
+		if i == 8 {
+			break
+		}
+		sample = append(sample, fmt.Sprintf("%d/%d/state%d/flags%#x", member.Proc.P_pid, member.Eproc.Pgid, member.Proc.P_stat, member.Proc.P_flag))
+	}
+	return strings.Join(sample, ",")
+}
+func zombieGroupState(pid int, group []unix.KinfoProc) (bool, error) {
+	if len(group) == 0 {
+		return false, errors.New("owned process-group query empty")
+	}
+	leader := false
+	allZombie := true
+	for _, member := range group {
+		if member.Eproc.Pgid != int32(pid) {
+			return false, errors.New("owned process-group identity mismatch")
+		}
+		switch member.Proc.P_stat {
+		case 1, 2, 3, 4:
+			if member.Proc.P_flag&darwinProcessExitingFlag == 0 {
+				return false, errors.New("owned process group has live member without exit transition")
+			}
+			allZombie = false
+		case darwinZombieState:
+		default:
+			return false, errors.New("owned process-group state unknown")
+		}
+		if member.Proc.P_pid == int32(pid) {
+			leader = true
+		}
+	}
+	if !leader {
+		return false, errors.New("owned unreaped group leader absent")
+	}
+	return allZombie, nil
+}
+func verifyZombieGroup(pid int, group []unix.KinfoProc) error {
+	zombie, err := zombieGroupState(pid, group)
+	if err != nil {
+		return err
+	}
+	if !zombie {
+		return errors.New("owned process group has live member")
+	}
+	return nil
+}
