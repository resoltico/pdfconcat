+				block := filepath.Join(root, "cache")
+				mustWrite(t, block, "block")
+				cmd.Env = append(cmd.Env, "GOCACHE="+block)
+			}
+			m := mutantExecutor{mutant: judgmentMutant{}, executionLogDir: t.TempDir()}
+			status, err := m.executeJudgedTest(ctx, cmd, root)
+			if status != c.want {
+				t.Fatalf("got %s want %s: %v", status, c.want, err)
+			}
+			if c.name == "pass" {
+				m.executionLogDir = t.TempDir()
+				cached := exec.CommandContext(ctx, "go", "test", "-json", "-timeout=200ms", "./...")
+				cached.Dir = root
+				cached.Env = cmd.Env
+				status, err = m.executeJudgedTest(ctx, cached, root)
+				if status != mutator.Lived {
+					t.Fatalf("cached lifecycle: %s %v", status, err)
+				}
+				files, err := filepath.Glob(filepath.Join(m.executionLogDir, "*.stdout.json"))
+				if err != nil || len(files) != 1 {
+					t.Fatalf("cached artifacts: %v", err)
+				}
+				raw, err := os.ReadFile(files[0])
+				if err != nil || !strings.Contains(string(raw), "(cached)") {
+					t.Fatalf("no actual cached replay: %v %s", err, raw)
+				}
+			}
+		})
+	}
+}
+func TestJudgmentRejectsIncompleteProtocol(t *testing.T) {
+	for _, raw := range []string{"", "garbage\n",
+		`{"Action":"start","Package":"p"}` + "\n" + `{"Action":"run","Package":"p","Test":"TestA"}` + "\n" + `{"Action":"fail","Package":"p","Test":"TestA"}` + "\n" + `{"Action":"run","Package":"p","Test":"TestB"}` + "\n" + `{"Action":"pass","Package":"p","Test":"TestB"}` + "\n" + `{"Action":"pass","Package":"p"}` + "\n", `{"Action":"start","Package":"p"}` + "\n", `{"Action":"start","Package":"p"}`} {
+		result, err := execution.JudgeTestStream(strings.NewReader(raw), t.TempDir(), nil, false, nil)
+		status := result.Status
+		if status != mutator.ExecutionError || err == nil {
+			t.Fatalf("accepted %q as %s", raw, status)
+		}
+	}
+}
+func TestJudgmentArtifactFailureIsError(t *testing.T) {
+	m := mutantExecutor{mutant: judgmentMutant{}, executionLogDir: filepath.Join(t.TempDir(), "missing")}
+	cmd := exec.Command("go", "version")
+	status, err := m.executeJudgedTest(context.Background(), cmd, t.TempDir())
+	if status != mutator.ExecutionError || err == nil {
+		t.Fatalf("artifact failure: %s %v", status, err)
+	}
+	if cmd.Process != nil {
+		t.Fatal("command executed without evidence files")
+	}
+}
+func mustWrite(t *testing.T, path, body string) {
+	t.Helper()
+	if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+		t.Fatal(fmt.Errorf("write fixture: %w", err))
+	}
+}
+func TestJudgmentResultArtifactFailureOverridesPassedTests(t *testing.T) {
+	root := t.TempDir()
+	mustWrite(t, filepath.Join(root, "go.mod"), "module probe.example\ngo 1.27.1\n")
+	mustWrite(t, filepath.Join(root, "value_test.go"), "package probe\nimport \"testing\"\nfunc TestValue(t *testing.T){}\n")
+	logs := t.TempDir()
+	key := fmt.Sprintf("%s:%s", judgmentMutant{}.Position(), judgmentMutant{}.Type())
+	digest := fmt.Sprintf("%x", sha256.Sum256([]byte(key)))
+	if err := os.Mkdir(filepath.Join(logs, digest+".result.json"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	m := mutantExecutor{mutant: judgmentMutant{}, executionLogDir: logs}
+	cmd := exec.Command("go", "test", "-json", "./...")
+	cmd.Dir = root
+	status, err := m.executeJudgedTest(context.Background(), cmd, root)
+	if status != mutator.ExecutionError || err == nil {
+		t.Fatalf("result artifact fault: %s %v", status, err)
+	}
+	raw, err := os.ReadFile(filepath.Join(logs, digest+".stdout.json"))
+	if err != nil || !strings.Contains(string(raw), `"Action":"pass"`) {
+		t.Fatalf("lost actual passing test evidence: %v", err)
+	}
+}
+func TestJudgmentBaselineCensusAndDynamicSubtests(t *testing.T) {
+	root := t.TempDir()
+	mustWrite(t, filepath.Join(root, "go.mod"), "module probe.example\ngo 1.27.1\n")
+	mustWrite(t, filepath.Join(root, "value_test.go"), "package probe\nimport \"testing\"\nfunc TestA(t *testing.T){t.Run(\"dynamic-first\",func(t *testing.T){})}\nfunc TestB(t *testing.T){}\n")
+	observe := func(args ...string) execution.TestJudgment {
+		t.Helper()
+		cmd := exec.Command("go", append([]string{"test", "-json"}, args...)...)
+		cmd.Dir = root
+		raw, runErr := cmd.Output()
+		result, err := execution.JudgeTestStream(strings.NewReader(string(raw)), root, runErr, false, nil)
+		if err != nil || result.Status != mutator.Lived {
+			t.Fatalf("baseline observation %s %v", result.Status, err)
+		}
+		return result
+	}
+	baseline := observe("./...")
+	cmd := exec.Command("go", "test", "-json", "-run=^TestA$", "./...")
+	cmd.Dir = root
+	raw, runErr := cmd.Output()
+	result, err := execution.JudgeTestStream(strings.NewReader(string(raw)), root, runErr, false, &baseline.Census)
+	if result.Status != mutator.ExecutionError || err == nil {
+		t.Fatal("partial successful suite accepted")
+	}
+	source, err := os.ReadFile(filepath.Join(root, "value_test.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	mustWrite(t, filepath.Join(root, "value_test.go"), strings.ReplaceAll(string(source), "dynamic-first", "dynamic-second"))
+	candidate := observe("./...")
+	if !reflect.DeepEqual(baseline.Census, candidate.Census) {
+		t.Fatalf("dynamic subtest froze census: %#v %#v", baseline.Census, candidate.Census)
+	}
+	cmd = exec.Command("go", "test", "-json", "./...")
+	cmd.Dir = root
+	raw, runErr = cmd.Output()
+	result, err = execution.JudgeTestStream(strings.NewReader(string(raw)), root, runErr, false, &baseline.Census)
+	if result.Status != mutator.Lived || err != nil {
+		t.Fatalf("valid changed subtest: %s %v", result.Status, err)
+	}
+}
+
+func TestCompilerInvalidExecutionKeepsCompleteNotViableReceipt(t *testing.T) {
+	root := t.TempDir()
+	mustWrite(t, filepath.Join(root, "go.mod"), "module probe.example\ngo 1.27.1\n")
+	mustWrite(t, filepath.Join(root, "value.go"), "package probe\nfunc broken(){_ = |nil}\n")
+	logs := t.TempDir()
+	m := mutantExecutor{mutant: judgmentMutant{}, executionLogDir: logs}
+	cmd := exec.Command("go", "test", "-json", "./...")
+	cmd.Dir = root
+	status, err := m.executeJudgedTest(context.Background(), cmd, root)
+	if status != mutator.NotViable || err != nil {
+		t.Fatalf("compiler-invalid result: %s %v", status, err)
+	}
+	entries, err := os.ReadDir(logs)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var receipt struct {
+		Status        string `json:"judgment_status"`
+		ArtifactError string `json:"artifact_error"`
+		StdoutHash    string `json:"stdout_sha256"`
+		StderrHash    string `json:"stderr_sha256"`
+		StdoutBytes   int64  `json:"stdout_bytes"`
+		StderrBytes   int64  `json:"stderr_bytes"`
+	}
+	found := false
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".result.json") {
+			continue
+		}
+		raw, err := os.ReadFile(filepath.Join(logs, entry.Name()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = json.Unmarshal(raw, &receipt); err != nil {
+			t.Fatal(err)
+		}
+		prefix := strings.TrimSuffix(entry.Name(), ".result.json")
+		for _, stream := range []struct {
+			suffix, hash string
+			bytes        int64
+		}{{".stdout.json", receipt.StdoutHash, receipt.StdoutBytes}, {".stderr.txt", receipt.StderrHash, receipt.StderrBytes}} {
+			data, err := os.ReadFile(filepath.Join(logs, prefix+stream.suffix))
+			if err != nil {
+				t.Fatal(err)
+			}
+			expected := fmt.Sprintf("%x", sha256.Sum256(data))
+			if stream.hash != expected || stream.bytes != int64(len(data)) {
+				t.Fatalf("unbound capture %s", stream.suffix)
+			}
+		}
+		found = true
+	}
+	if !found || receipt.Status != mutator.NotViable.String() || receipt.ArtifactError != "" || receipt.StdoutBytes == 0 {
+		t.Fatalf("incomplete compiler receipt: %+v found%t", receipt, found)
+	}
+}
