@@ -0,0 +1,104 @@
+//go:build darwin
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"errors"
+	"golang.org/x/sys/unix"
+	"io"
+	"os/exec"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestOwnedZombieGroupProof(t *testing.T) {
+	cmd := exec.Command("/usr/bin/true")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	pipe, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	_, err = io.Copy(io.Discard, pipe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pid := cmd.Process.Pid
+	deadline := time.Now().Add(time.Second)
+	for {
+		group, err := unix.SysctlKinfoProcSlice("kern.proc.pgrp", pid)
+		if err == nil && verifyZombieGroup(pid, group) == nil {
+			break
+		}
+		if !time.Now().Before(deadline) {
+			_ = cmd.Process.Kill()
+			_ = cmd.Wait()
+			t.Fatal("owned leader never reached proven zombie state")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	killErr := unix.Kill(-pid, unix.SIGKILL)
+	if !errors.Is(killErr, unix.EPERM) {
+		_ = cmd.Wait()
+		t.Fatalf("expected native zombie-only EPERM: %v", killErr)
+	}
+	if err := normalizeGroupKillError(pid, killErr, time.Now().Add(goCommandCleanupBudget)); err != nil {
+		_ = cmd.Wait()
+		t.Fatal(err)
+	}
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestOwnedZombieProofRejectsUnknownAndLiveMembers(t *testing.T) {
+	const pid = 123
+	leader := unix.KinfoProc{}
+	leader.Proc.P_pid = pid
+	leader.Eproc.Pgid = pid
+	leader.Proc.P_stat = darwinZombieState
+	for _, kind := range []string{"empty", "missing-leader", "wrong-group", "live", "unknown"} {
+		t.Run(kind, func(t *testing.T) {
+			record := leader
+			var group []unix.KinfoProc
+			switch kind {
+			case "empty":
+			case "missing-leader":
+				record.Proc.P_pid++
+				group = []unix.KinfoProc{record}
+			case "wrong-group":
+				record.Eproc.Pgid++
+				group = []unix.KinfoProc{record}
+			case "live":
+				record.Proc.P_stat = 2
+				group = []unix.KinfoProc{record}
+			case "unknown":
+				record.Proc.P_stat = 99
+				group = []unix.KinfoProc{record}
+			}
+			if verifyZombieGroup(pid, group) == nil {
+				t.Fatal("unknown/live group proof accepted")
+			}
+		})
+	}
+	if normalizeGroupKillError(pid, unix.EIO, time.Now().Add(goCommandCleanupBudget)) == nil {
+		t.Fatal("unknown syscall error accepted")
+	}
+	cmd := exec.Command("/bin/sleep", "10")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if normalizeGroupKillError(cmd.Process.Pid, unix.EPERM, time.Now().Add(goCommandCleanupBudget)) == nil {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		t.Fatal("real live owned group accepted as zombie")
+	}
+	_ = cmd.Process.Kill()
+	if err := cmd.Wait(); err == nil {
+		t.Fatal("sleep was not terminated")
+	}
+}
