diff --git a/internal/execution/test_judgment.go b/internal/execution/test_judgment.go
new file mode 100644
index 0000000..a333826
--- /dev/null
+++ b/internal/execution/test_judgment.go
@@ -0,0 +1,303 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/go-gremlins/gremlins/internal/mutator"
+)
+
+// packageJudgment keeps only facts needed for judging; complete output lives on disk.
+type packageJudgment struct {
+	started, finished, failed, namedFailed, panicSeen, stackSeen bool
+	tests                                                        map[string]string
+	outcome                                                      string
+}
+type testEvent struct {
+	Action, Package, Test, Output, ImportPath, FailedBuild string
+}
+
+var compilerSourceLocation = regexp.MustCompile(`^(.+\.go):[0-9]+(?::[0-9]+)?: .+`)
+
+func JudgeTestStream(reader io.Reader, root string, runErr error, timedOut bool, expected *TestCensus) (TestJudgment, error) {
+	packages := map[string]*packageJudgment{}
+	builds := map[string]bool{}
+	sourceDiagnostics := map[string]bool{}
+	passedTests := 0
+	timeoutSeen, infrastructure := false, false
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 16*1024*1024)
+	scanner.Split(framedJSONLine)
+	for scanner.Scan() {
+		var event testEvent
+		if err := json.Unmarshal(scanner.Bytes(), &event); err != nil {
+			return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("malformed Go test JSON: %w", err)
+		}
+		if event.Action == "build-output" {
+			if event.ImportPath == "" {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("build output without import path")
+			}
+			for _, line := range strings.Split(event.Output, "\n") {
+				if ownedCompilerDiagnostic(line, root) {
+					sourceDiagnostics[event.ImportPath] = true
+				}
+				infrastructure = infrastructure || InfrastructureOutput(line) || strings.Contains(line, "internal compiler error")
+			}
+			continue
+		}
+		if event.Action == "build-fail" {
+			if event.ImportPath == "" {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("build failure without import path")
+			}
+			builds[event.ImportPath] = true
+			continue
+		}
+		if event.Package == "" {
+			return TestJudgment{Status: mutator.ExecutionError}, errors.New("Go test event without package")
+		}
+		p := packages[event.Package]
+		if p == nil {
+			p = &packageJudgment{tests: map[string]string{}}
+			packages[event.Package] = p
+		}
+		switch event.Action {
+		case "start":
+			if p.started {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("duplicate package start")
+			}
+			p.started = true
+		case "run", "pause", "cont", "bench":
+			if !p.started || p.finished || event.Test == "" {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("invalid named test lifecycle")
+			}
+			if event.Action == "run" {
+				if _, exists := p.tests[event.Test]; exists {
+					return TestJudgment{Status: mutator.ExecutionError}, errors.New("duplicate named test")
+				}
+				p.tests[event.Test] = "running"
+			} else if _, exists := p.tests[event.Test]; !exists {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("named test event before run")
+			}
+		case "output":
+			if !p.started || p.finished {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("output outside package lifecycle")
+			}
+			for _, line := range strings.Split(event.Output, "\n") {
+				infrastructure = infrastructure || InfrastructureOutput(line)
+				if strings.HasPrefix(line, "panic: test timed out after ") {
+					timeoutSeen = true
+				}
+				if strings.HasPrefix(line, "panic: ") || line == "fatal error: all goroutines are asleep - deadlock!" {
+					p.panicSeen = true
+				}
+				if strings.HasPrefix(line, "goroutine ") && strings.HasSuffix(line, "]:") {
+					p.stackSeen = true
+				}
+			}
+		case "pass", "fail", "skip":
+			if !p.started || p.finished {
+				return TestJudgment{Status: mutator.ExecutionError}, errors.New("terminal event outside package lifecycle")
+			}
+			if event.Test != "" {
+				done, exists := p.tests[event.Test]
+				if !exists || done != "running" {
+					return TestJudgment{Status: mutator.ExecutionError}, errors.New("named result without active test")
+				}
+				p.tests[event.Test] = event.Action
+				if event.Action == "pass" {
+					passedTests++
+				}
+				if event.Action == "fail" {
+					p.namedFailed = true
+				}
+			} else {
+				p.finished = true
+				p.outcome = event.Action
+				p.failed = event.Action == "fail"
+				if event.FailedBuild != "" {
+					builds[event.FailedBuild] = true
+				}
+			}
+		default:
+			return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("unknown Go test action %q", event.Action)
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("read Go test JSON: %w", err)
+	}
+	if infrastructure {
+		return TestJudgment{Status: mutator.ExecutionError}, errors.New("test infrastructure/resource failure; see raw output")
+	}
+	if errors.Is(runErr, context.Canceled) {
+		return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("test execution canceled: %w", runErr)
+	}
+	if timedOut || timeoutSeen {
+		return TestJudgment{Status: mutator.TimedOut}, nil
+	}
+	if len(packages) == 0 {
+		return TestJudgment{Status: mutator.ExecutionError}, errors.Join(errors.New("no package execution evidence"), runErr)
+	}
+	for name, p := range packages {
+		if !p.started || !p.finished {
+			return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("incomplete package %s", name)
+		}
+	}
+	var exitErr interface {
+		error
+		ExitCode() int
+	}
+	if runErr != nil && (!errors.As(runErr, &exitErr) || exitErr.ExitCode() != 1) {
+		return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("unexpected Go test process failure: %w", runErr)
+	}
+	if len(builds) > 0 {
+		for name := range builds {
+			if !sourceDiagnostics[name] {
+				return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("build failure without owned source diagnostic: %s", name)
+			}
+		}
+		if runErr == nil {
+			return TestJudgment{Status: mutator.ExecutionError}, errors.New("build failure with successful process exit")
+		}
+		return TestJudgment{Status: mutator.NotViable}, nil
+	}
+	for name, p := range packages {
+		if p.namedFailed && !p.failed {
+			return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("named failure but package passed: %s", name)
+		}
+		if p.failed && !(p.panicSeen && p.stackSeen) {
+			for test, outcome := range p.tests {
+				if outcome == "running" {
+					return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("unfinished named test after unknown failure: %s/%s", name, test)
+				}
+			}
+		}
+	}
+	failed := false
+	for name, p := range packages {
+		if p.failed {
+			failed = true
+			if !p.namedFailed && !(p.panicSeen && p.stackSeen) {
+				return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("unclassified package failure: %s", name)
+			}
+		}
+	}
+	if failed {
+		if runErr == nil {
+			return TestJudgment{Status: mutator.ExecutionError}, errors.New("package failure with successful process exit")
+		}
+		return TestJudgment{Status: mutator.Killed}, nil
+	}
+	if runErr != nil {
+		return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("process failure without failed package: %w", runErr)
+	}
+	for name, p := range packages {
+		for test, done := range p.tests {
+			if done == "running" {
+				return TestJudgment{Status: mutator.ExecutionError}, fmt.Errorf("unfinished named test %s/%s", name, test)
+			}
+		}
+	}
+	if passedTests == 0 {
+		return TestJudgment{Status: mutator.ExecutionError}, errors.New("no passed named tests (empty or entirely skipped run)")
+	}
+	census := TestCensus{}
+	for name, p := range packages {
+		entry := PackageCensus{Outcome: p.outcome, Tests: map[string]string{}}
+		for name, outcome := range p.tests {
+			if !strings.Contains(name, "/") {
+				entry.Tests[name] = outcome
+			}
+		}
+		census[name] = entry
+	}
+	if expected != nil {
+		if err := compareTestCensus(*expected, census); err != nil {
+			return TestJudgment{Status: mutator.ExecutionError, Census: census}, err
+		}
+	}
+	return TestJudgment{Status: mutator.Lived, Census: census}, nil
+}
+func ownedCompilerDiagnostic(line, root string) bool {
+	match := compilerSourceLocation.FindStringSubmatch(line)
+	if match == nil {
+		return false
+	}
+	path := match[1]
+	if !filepath.IsAbs(path) {
+		path = filepath.Join(root, path)
+	}
+	relative, err := filepath.Rel(root, path)
+	if err != nil || relative == ".." || strings.HasPrefix(relative, ".."+string(filepath.Separator)) {
+		return false
+	}
+	info, err := os.Stat(path)
+	return err == nil && info.Mode().IsRegular()
+}
+func InfrastructureOutput(line string) bool {
+	return strings.HasPrefix(line, "signal: ") || strings.Contains(line, "runtime: out of memory") || strings.Contains(line, "runtime: cannot allocate memory") || strings.Contains(line, "runtime: failed to create new OS thread") || strings.Contains(line, "fatal error: newosproc")
+}
+
+func framedJSONLine(data []byte, atEOF bool) (int, []byte, error) {
+	if i := bytes.IndexByte(data, '\n'); i >= 0 {
+		return i + 1, data[:i], nil
+	}
+	if atEOF && len(data) > 0 {
+		return 0, nil, errors.New("unterminated Go test JSON record")
+	}
+	return 0, nil, nil
+}
+
+// TestCensus identifies stable packages and top-level tests. Dynamic subtest names are excluded.
+type TestCensus map[string]PackageCensus
+type PackageCensus struct {
+	Outcome string
+	Tests   map[string]string
+}
+type TestJudgment struct {
+	Status mutator.Status
+	Census TestCensus
+}
+
+func compareTestCensus(expected, actual TestCensus) error {
+	if len(expected) != len(actual) {
+		return fmt.Errorf("package census changed: got %d want %d", len(actual), len(expected))
+	}
+	for name, want := range expected {
+		got, exists := actual[name]
+		if !exists {
+			return fmt.Errorf("baseline package missing: %s", name)
+		}
+		if got.Outcome != want.Outcome || len(got.Tests) != len(want.Tests) {
+			return fmt.Errorf("baseline package/test outcomes changed: %s", name)
+		}
+		for test, outcome := range want.Tests {
+			if got.Tests[test] != outcome {
+				return fmt.Errorf("baseline top-level outcome changed: %s/%s", name, test)
+			}
+		}
+	}
+	return nil
+}
+
+// CheckInfrastructureStream rejects resource diagnostics while preserving complete raw files.
+func CheckInfrastructureStream(reader io.Reader) error {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 16*1024*1024)
+	var observed error
+	for scanner.Scan() {
+		if InfrastructureOutput(scanner.Text()) {
+			observed = errors.New("infrastructure/resource diagnostic; see raw artifact")
+		}
+	}
+	return errors.Join(observed, scanner.Err())
+}
diff --git a/internal/execution/zombie_wait_darwin_test.go b/internal/execution/zombie_wait_darwin_test.go
new file mode 100644
index 0000000..7c31964
--- /dev/null
+++ b/internal/execution/zombie_wait_darwin_test.go
@@ -0,0 +1,165 @@
+//go:build darwin
+
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"errors"
+	"golang.org/x/sys/unix"
+	"io"
+	"os"
+	"os/exec"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestZombieProofRetriesOnlyKnownTransitionBeforeOwnedWait(t *testing.T) {
+	cmd := exec.Command("/usr/bin/true")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	pipe, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Wait()
+	_, _ = io.Copy(io.Discard, pipe)
+	pid := cmd.Process.Pid
+	calls := 0
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	err = waitForZombieGroup(ctx, pid, unix.EPERM, func() ([]unix.KinfoProc, error) {
+		calls++
+		group, e := unix.SysctlKinfoProcSlice("kern.proc.pgrp", pid)
+		if calls == 1 && e == nil {
+			for i := range group {
+				group[i].Proc.P_stat = 2
+			}
+		}
+		return group, e
+	})
+	if err != nil || calls < 2 {
+		t.Fatalf("known transient did not yield real owned zombie proof: calls%d %v", calls, err)
+	}
+}
+func TestZombieProofRejectsDeadlineAndUnknownQueries(t *testing.T) {
+	const pid = 123
+	leader := unix.KinfoProc{}
+	leader.Proc.P_pid = pid
+	leader.Eproc.Pgid = pid
+	leader.Proc.P_stat = 5
+	for _, kind := range []string{"empty", "missing-leader", "wrong-group", "unknown-state", "query-error", "late-success", "still-live"} {
+		t.Run(kind, func(t *testing.T) {
+			calls := 0
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+			defer cancel()
+			err := waitForZombieGroup(ctx, pid, unix.EPERM, func() ([]unix.KinfoProc, error) {
+				calls++
+				m := leader
+				switch kind {
+				case "empty":
+					return nil, nil
+				case "missing-leader":
+					m.Proc.P_pid++
+				case "wrong-group":
+					m.Eproc.Pgid++
+				case "unknown-state":
+					m.Proc.P_stat = 6
+				case "query-error":
+					return nil, unix.EIO
+				case "late-success":
+					time.Sleep(10 * time.Millisecond)
+				case "still-live":
+					m.Proc.P_stat = 2
+				}
+				return []unix.KinfoProc{m}, nil
+			})
+			if err == nil || !errors.Is(err, unix.EPERM) {
+				t.Fatalf("unknown/live/deadline proof accepted: %v", err)
+			}
+			if kind != "still-live" && calls != 1 {
+				t.Fatalf("unowned/unknown query retried: %d", calls)
+			}
+		})
+	}
+}
+func TestZombieLeaderWithLiveOwnedMemberIsNotAProof(t *testing.T) {
+	cmd := exec.Command("/bin/sh", "-c", "sleep 10 >/dev/null 2>&1 & exit 0")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	p, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = unix.Kill(-cmd.Process.Pid, unix.SIGKILL); _ = cmd.Wait() }()
+	_, _ = io.Copy(io.Discard, p)
+	if err := normalizeGroupKillError(cmd.Process.Pid, unix.EPERM, time.Now().Add(goCommandCleanupBudget)); err == nil {
+		t.Fatal("zombie leader with live child accepted")
+	}
+}
+func TestNativeFastExitRunnerKeepsOwnershipThroughCleanup(t *testing.T) {
+	dir := t.TempDir()
+	for i := 0; i < 100; i++ {
+		out, err := os.CreateTemp(dir, "stdout-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		stderr, err := os.CreateTemp(dir, "stderr-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		runErr, cleanupErr, started := RunGoCommand(context.Background(), exec.Command("/usr/bin/true"), out, stderr)
+		if err := errors.Join(out.Close(), stderr.Close()); err != nil {
+			t.Fatal(err)
+		}
+		if !started || runErr != nil || cleanupErr != nil {
+			t.Fatalf("native fast exit rejected at%d: %v %v", i, runErr, cleanupErr)
+		}
+	}
+}
+
+// A slow exiting-state observation must share the command cleanup allowance, not a separate 50ms allowance.
+func TestOwnedExitingTransitionUsesCleanupDeadlineAndFinalZombieProof(t *testing.T) {
+	cmd := exec.Command("/usr/bin/true")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	pipe, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Wait()
+	if _, err = io.Copy(io.Discard, pipe); err != nil {
+		t.Fatal(err)
+	}
+	pid := cmd.Process.Pid
+	deadline := time.Now().Add(goCommandCleanupBudget)
+	transition := time.Now().Add(80 * time.Millisecond)
+	observedExiting := false
+	observedZombie := false
+	err = proveOwnedGroupTermination(pid, unix.EPERM, deadline, func() ([]unix.KinfoProc, error) {
+		group, err := unix.SysctlKinfoProcSlice("kern.proc.pgrp", pid)
+		if err != nil {
+			return nil, err
+		}
+		if time.Now().Before(transition) {
+			for i := range group {
+				group[i].Proc.P_stat = 2
+				group[i].Proc.P_flag |= darwinProcessExitingFlag
+			}
+			observedExiting = true
+		} else {
+			observedZombie, err = zombieGroupState(pid, group)
+		}
+		return group, err
+	})
+	if err != nil || !observedExiting || !observedZombie {
+		t.Fatalf("owned terminal transition: %v exiting%t zombie%t", err, observedExiting, observedZombie)
+	}
+}
