diff --git a/internal/execution/go_cache.go b/internal/execution/go_cache.go
new file mode 100644
index 0000000..a34a904
--- /dev/null
+++ b/internal/execution/go_cache.go
@@ -0,0 +1,166 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package execution
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io/fs"
+	"math"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"time"
+)
+
+const GoCacheBudgetBytes int64 = 4 << 30
+
+// GoCache owns one exclusively used temporary cache through a live directory lease.
+// The budget is a post-command trim trigger, with one-command growth overshoot.
+type GoCache struct {
+	Path              string
+	lease             *os.File
+	budget, lastBytes int64
+}
+
+func NewGoCache(parent string) (*GoCache, error) {
+	path, err := os.MkdirTemp(parent, "go-build-")
+	if err != nil {
+		return nil, err
+	}
+	lease, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	return &GoCache{Path: path, lease: lease, budget: GoCacheBudgetBytes}, nil
+}
+func (c *GoCache) Close() error {
+	if c == nil || c.lease == nil {
+		return nil
+	}
+	if err := c.Verify(); err != nil {
+		return errors.Join(err, c.lease.Close())
+	}
+	return errors.Join(os.RemoveAll(c.Path), c.lease.Close())
+}
+func (c *GoCache) Verify() error {
+	info, err := os.Lstat(c.Path)
+	if err != nil {
+		return err
+	}
+	if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.New("owned Go cache path is not a regular directory")
+	}
+	original, err := c.lease.Stat()
+	if err != nil {
+		return err
+	}
+	current, err := os.Open(c.Path)
+	if err != nil {
+		return err
+	}
+	actual, statErr := current.Stat()
+	closeErr := current.Close()
+	if statErr != nil || closeErr != nil {
+		return errors.Join(statErr, closeErr)
+	}
+	if !os.SameFile(original, actual) {
+		return errors.New("owned Go cache directory was substituted")
+	}
+	return nil
+}
+func (c *GoCache) Configure(cmd *exec.Cmd) error {
+	if err := c.Verify(); err != nil {
+		return err
+	}
+	cmd.Env = append(cmd.Environ(), "GOCACHE="+c.Path, "GOCACHEPROG=")
+	return nil
+}
+func (c *GoCache) logicalBytes() (int64, error) {
+	if err := c.Verify(); err != nil {
+		return 0, err
+	}
+	var total int64
+	err := filepath.WalkDir(c.Path, func(path string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.Type()&os.ModeSymlink != 0 {
+			return errors.New("symlink in owned Go cache")
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() {
+			return errors.New("nonregular entry in owned Go cache")
+		}
+		if info.Size() > math.MaxInt64-total {
+			return errors.New("owned Go cache size overflow")
+		}
+		total += info.Size()
+		return nil
+	})
+	return total, errors.Join(err, c.Verify())
+}
+func (c *GoCache) AfterCommand(ctx context.Context, original *exec.Cmd, logs, key string) error {
+	before := c.lastBytes
+	after, inspectErr := c.logicalBytes()
+	var trimErr error
+	trimmed := false
+	final := after
+	if inspectErr == nil && after > c.budget && ctx.Err() == nil {
+		trimmed = true
+		cleanCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+		defer cancel()
+		clean := exec.CommandContext(cleanCtx, original.Path, "clean", "-cache")
+		clean.Dir = original.Dir
+		clean.Env = original.Environ()
+		if err := c.Configure(clean); err != nil {
+			trimErr = err
+		} else {
+			out, err := os.OpenFile(filepath.Join(logs, key+".cache-clean.stdout.log"), os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+			if err != nil {
+				trimErr = err
+			} else {
+				stderr, err := os.OpenFile(filepath.Join(logs, key+".cache-clean.stderr.log"), os.O_CREATE|os.O_EXCL|os.O_RDWR, 0o600)
+				if err != nil {
+					trimErr = errors.Join(err, out.Close())
+				} else {
+					runErr, cleanupErr, _ := RunGoCommand(cleanCtx, clean, out, stderr)
+					trimErr = errors.Join(runErr, cleanupErr, out.Close(), stderr.Close())
+				}
+			}
+		}
+		var finalErr error
+		final, finalErr = c.logicalBytes()
+		trimErr = errors.Join(trimErr, finalErr)
+		if trimErr == nil && final > c.budget {
+			trimErr = errors.New("Go clean did not reduce owned cache below trigger")
+		}
+	}
+	receipt := struct {
+		Cache                                                       string
+		BudgetBytes, BeforeBytes, AfterCommandBytes, AfterTrimBytes int64
+		Trimmed                                                     bool
+		InspectionError, TrimError                                  string
+	}{c.Path, c.budget, before, after, final, trimmed, errorMessage(inspectErr), errorMessage(trimErr)}
+	data, encodeErr := json.MarshalIndent(receipt, "", "  ")
+	file, writeErr := os.OpenFile(filepath.Join(logs, key+".cache.json"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if writeErr == nil {
+		_, err := file.Write(data)
+		writeErr = errors.Join(err, file.Close())
+	}
+	c.lastBytes = final
+	return errors.Join(inspectErr, trimErr, encodeErr, writeErr)
+}
+func errorMessage(err error) string {
+	if err == nil {
+		return ""
+	}
+	return fmt.Sprint(err)
+}
