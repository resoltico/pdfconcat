--- /dev/null
+++ b/internal/coverage/cancellation_test.go
@@ -0,0 +1,107 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package coverage_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/go-gremlins/gremlins/internal/coverage"
+	"github.com/go-gremlins/gremlins/internal/gomodule"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestCoverageCancellationStopsActualTestProcess(t *testing.T) {
+	original, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := os.Chdir(original); err != nil {
+			t.Fatal(err)
+		}
+	}()
+	root := t.TempDir()
+	logs := t.TempDir()
+	heartbeat := filepath.Join(logs, "heartbeat")
+	write := func(name, body string) {
+		t.Helper()
+		if err := os.WriteFile(filepath.Join(root, name), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write("go.mod", "module cancellation.example\ngo 1.27.1\n")
+	write("value.go", "package cancellation\nfunc Value()int{return 4}\n")
+	write("value_test.go", fmt.Sprintf("package cancellation\nimport(\"testing\";\"os\";\"time\")\nfunc TestWait(t *testing.T){for{_=os.WriteFile(%q,[]byte(time.Now().String()),0600);time.Sleep(10*time.Millisecond)}}\n", heartbeat))
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := coverage.New(logs, gomodule.GoModule{Name: "cancellation.example", Root: root, CallingDir: "."}, coverage.WithContext(ctx))
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, err := c.Run()
+		finished <- err
+	}()
+	// Join before working-directory restoration and TempDir cleanup on every exit.
+	defer func() {
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(7 * time.Second):
+			t.Error("canceled producer did not join before fixture cleanup")
+		}
+	}()
+	started := time.Now()
+	// A private cold Go cache compiles the SDK before the actual test can start.
+	// Startup is not cancellation latency; retain a bounded prerequisite allowance.
+	deadline := started.Add(120 * time.Second)
+	if enclosing, ok := t.Deadline(); ok && enclosing.Add(-15*time.Second).Before(deadline) {
+		deadline = enclosing.Add(-15 * time.Second)
+	}
+	for {
+		data, err := os.ReadFile(heartbeat)
+		if err == nil && len(data) > 0 {
+			break
+		}
+		if !time.Now().Before(deadline) {
+			cancel()
+			t.Fatal("actual baseline test never started")
+		}
+		select {
+		case <-done:
+			t.Fatalf("producer exited before the actual test started: %v", <-finished)
+		default:
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Logf("actual test readiness after %s", time.Since(started))
+	cancel()
+	select {
+	case err := <-finished:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("cancellation cause lost: %v", err)
+		}
+	case <-time.After(7 * time.Second):
+		t.Fatal("baseline cancellation did not finish")
+	}
+	before, err := os.ReadFile(heartbeat)
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	after, err := os.ReadFile(heartbeat)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(before) != string(after) {
+		t.Fatal("baseline test survived cancellation")
+	}
+	for _, name := range []string{"download.stdout.log", "download.stderr.log", "baseline.stdout.json", "baseline.stderr.txt"} {
+		if _, err := os.Stat(filepath.Join(logs, name)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
