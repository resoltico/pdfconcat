+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package workdir
+
+import (
+	"fmt"
+	"golang.org/x/sys/unix"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime/debug"
+	"testing"
+)
+
+func TestCopyBoundedDescriptorsHelper(t *testing.T) {
+	if os.Getenv("GREMLINS_COPY_LIMIT_HELPER") != "1" {
+		return
+	}
+	var limit unix.Rlimit
+	if err := unix.Getrlimit(unix.RLIMIT_NOFILE, &limit); err != nil {
+		t.Fatal(err)
+	}
+	limit.Cur = 96
+	if err := unix.Setrlimit(unix.RLIMIT_NOFILE, &limit); err != nil {
+		t.Fatal(err)
+	}
+	debug.SetGCPercent(-1)
+	source := t.TempDir()
+	destination := t.TempDir()
+	for i := 0; i < 64; i++ {
+		if err := os.WriteFile(filepath.Join(source, fmt.Sprintf("file-%d", i)), []byte("owned source bytes"), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	dealer := NewCachedDealer(destination, source)
+	copy, err := dealer.Get("bounded")
+	if err != nil {
+		t.Fatalf("copy exhausted descriptors while GC disabled: %v", err)
+	}
+	for i := 0; i < 64; i++ {
+		data, err := os.ReadFile(filepath.Join(copy, fmt.Sprintf("file-%d", i)))
+		if err != nil || string(data) != "owned source bytes" {
+			t.Fatalf("copy contents: %v", err)
+		}
+	}
+}
+func TestCopyClosesDescriptorsWithGCDisabled(t *testing.T) {
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(executable, "-test.run=^TestCopyBoundedDescriptorsHelper$")
+	cmd.Env = append(os.Environ(), "GREMLINS_COPY_LIMIT_HELPER=1")
+	raw, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("native low-limit copy control: %v\n%s", err, raw)
+	}
+}
diff --git a/internal/engine/workdir/scratch.go b/internal/engine/workdir/scratch.go
new file mode 100644
index 0000000..4d4cfeb
--- /dev/null
+++ b/internal/engine/workdir/scratch.go
@@ -0,0 +1,121 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package workdir
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+// ScratchDirectory owns a freshly created mutation workspace through retained SDK handles.
+// Clean runs only after its producers have stopped; it never repairs user-supplied directories.
+type ScratchDirectory struct {
+	path     string
+	root     *os.Root
+	pin      *os.File
+	identity os.FileInfo
+}
+
+func NewScratch(parent, prefix string) (*ScratchDirectory, error) {
+	path, err := os.MkdirTemp(parent, prefix)
+	if err != nil {
+		return nil, err
+	}
+	pin, err := os.Open(path)
+	if err != nil {
+		return nil, errors.Join(err, os.RemoveAll(path))
+	}
+	info, err := pin.Stat()
+	if err != nil {
+		return nil, errors.Join(err, pin.Close(), os.RemoveAll(path))
+	}
+	root, err := os.OpenRoot(path)
+	if err != nil {
+		return nil, errors.Join(err, pin.Close(), os.RemoveAll(path))
+	}
+	owned, err := root.Lstat(".")
+	if err != nil || !os.SameFile(info, owned) {
+		return nil, errors.Join(err, errors.New("new scratch identity changed"), root.Close(), pin.Close())
+	}
+	return &ScratchDirectory{path: path, root: root, pin: pin, identity: info}, nil
+}
+func (d *ScratchDirectory) Path() string { return d.path }
+func (d *ScratchDirectory) Clean() (resultErr error) {
+	closed := false
+	defer func() {
+		if !closed {
+			resultErr = errors.Join(resultErr, d.root.Close(), d.pin.Close())
+		}
+	}()
+	parent, err := os.OpenRoot(filepath.Dir(d.path))
+	if err != nil {
+		return err
+	}
+	defer func() { resultErr = errors.Join(resultErr, parent.Close()) }()
+	base := filepath.Base(d.path)
+	current, err := parent.Lstat(base)
+	if os.IsNotExist(err) {
+		return errors.Join(err, errors.New("scratch namespace missing; owned object may have moved"))
+	}
+	if err != nil {
+		return err
+	}
+	if !current.IsDir() || current.Mode()&os.ModeSymlink != 0 || !os.SameFile(d.identity, current) {
+		return errors.New("scratch namespace identity changed; unknown entry preserved")
+	}
+	live, err := d.pin.Stat()
+	if err != nil {
+		return err
+	}
+	if !os.SameFile(d.identity, live) {
+		return errors.New("scratch retained identity changed")
+	}
+	// The retained descriptor can restore a root mode 000; path-based chmod cannot search it.
+	if err = d.pin.Chmod(current.Mode().Perm() | 0o700); err != nil {
+		return err
+	}
+	walkErr := fs.WalkDir(d.root.FS(), ".", func(name string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.Type()&os.ModeSymlink != 0 || !entry.IsDir() {
+			return nil
+		}
+		info, err := d.root.Lstat(name)
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("scratch directory changed during cleanup")
+		}
+		return d.root.Chmod(name, info.Mode().Perm()|0o700)
+	})
+	if walkErr != nil {
+		return walkErr
+	}
+	// Delete children within the pinned object, never by reopening its original name.
+	children, err := fs.ReadDir(d.root.FS(), ".")
+	if err != nil {
+		return err
+	}
+	var removeErr error
+	for _, child := range children {
+		removeErr = errors.Join(removeErr, d.root.RemoveAll(child.Name()))
+	}
+	closeErr := errors.Join(d.root.Close(), d.pin.Close())
+	closed = true
+	if removeErr != nil {
+		return errors.Join(removeErr, closeErr)
+	}
+	// Remove the empty original root only after an exact parent-relative identity check.
+	current, err = parent.Lstat(base)
+	if err != nil {
+		return errors.Join(closeErr, err)
+	}
+	if !current.IsDir() || !os.SameFile(d.identity, current) {
+		return errors.Join(closeErr, fmt.Errorf("scratch identity changed before removal; unknown entry preserved"))
+	}
+	return errors.Join(closeErr, parent.Remove(base))
+}
