diff --git a/internal/engine/physical_position_test.go b/internal/engine/physical_position_test.go
new file mode 100644
index 0000000..57891d6
--- /dev/null
+++ b/internal/engine/physical_position_test.go
@@ -0,0 +1,78 @@
+// Copyright 2026. Licensed under the Apache License, Version 2.0.
+package engine
+
+import (
+	"github.com/go-gremlins/gremlins/internal/mutator"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPhysicalMutationPositionAppliesAndRestoresDirectiveSource(t *testing.T) {
+	source := []byte("//line /tmp/unowned.go:100\npackage physical\nconst Shift = 1 << 2\nfunc Value()int{return Shift}\n")
+	root := t.TempDir()
+	path := filepath.Join(root, "value.go")
+	if err := os.WriteFile(path, source, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	set := token.NewFileSet()
+	file, err := parser.ParseFile(set, "value.go", source, parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var candidate *NodeToken
+	ast.Inspect(file, func(n ast.Node) bool {
+		if node, ok := NewTokenNode(n); ok && node.Tok() == token.SHL {
+			candidate = node
+		}
+		return true
+	})
+	if candidate == nil {
+		t.Fatal("fixture operator absent")
+	}
+	m := NewTokenMutant("physical.example", set, file, candidate)
+	m.SetType(mutator.InvertBitwise)
+	m.SetStatus(mutator.NotCovered)
+	m.SetWorkdir(root)
+	position := m.Position()
+	if position.Filename != "value.go" || position.Line != 3 || position.Column != 17 {
+		t.Fatalf("forged mutation identity: %+v", position)
+	}
+	if err := m.Apply(); err != nil {
+		t.Fatal(err)
+	}
+	changed, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parsed, err := parser.ParseFile(token.NewFileSet(), "value.go", changed, parser.ParseComments)
+	if err != nil {
+		t.Fatal(err)
+	}
+	seen := false
+	ast.Inspect(parsed, func(n ast.Node) bool {
+		if binary, ok := n.(*ast.BinaryExpr); ok {
+			seen = true
+			if binary.Op != token.SHR {
+				t.Errorf("wrong physical operator changed: %s", binary.Op)
+			}
+		}
+		return true
+	})
+	if !seen {
+		t.Fatal("mutation removed operator")
+	}
+	if err := m.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(restored) != string(source) {
+		t.Fatal("physical source not restored exactly")
+	}
+}
