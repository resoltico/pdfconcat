# Authoritative versions of the development tools. Read by tools/installtools, by .github/workflows
# (appended to $GITHUB_ENV), and checked against derived copies by internal/repopolicy.
# The Go toolchain version is the `go` directive in ../go.mod and is not repeated here.
GOLANGCI_LINT_VERSION=v2.14.0
GORELEASER_VERSION=v2.18.2
GOVULNCHECK_VERSION=v1.8.0
GREMLINS_VERSION=v0.6.0
# Verified upstream source with the reviewed executor patch; distinct native variant uses its full digest.
GREMLINS_SOURCE_ZIP_SHA256=50af4000c527a392363cf76fb31b1669d7527ccdec1753c0dd2e2a875a8376ae
GREMLINS_SOURCE_SUM=h1:3G2ROO0I3q4bb5bxElQIUITTuEbl1iOfVYFqunGwrJI=
GREMLINS_SOURCE_MOD_SUM=h1:LLbvJR33CWsu1sgvQ4qMzU2rqkwYJK3Qy/Al59eHKjA=
GREMLINS_SOURCE_TIME=2025-12-05T05:14:22Z
GREMLINS_PATCH_SHA256=88d62dac83fcd8bf7faa62e25e7755593a7156c54dd1faed3d47e6f5c21d5f3c
ACTIONLINT_VERSION=v1.7.12
# Official Gitleaks release manifest digest; the mutable upstream release has no immutable attestation.
GITLEAKS_VERSION=v8.30.1
GITLEAKS_CHECKSUMS_SHA256=061476c21adaf5441516f96f185c1a4706a83cd6329b9b38762271b3d4a52fae

# Independent PDF QA tools used by tests as oracles (development and CI only; PDFConcat never runs them).
# Windows installs these exact Chocolatey versions. Linux and macOS install the distribution's or
# Homebrew's current packages, which cannot be pinned, so every platform enforces the minimum
# versions below (the oldest the tests were written against) and prints what it installed.
CHOCO_QPDF_VERSION=12.4.2
CHOCO_POPPLER_VERSION=26.9.0
QA_QPDF_MIN_VERSION=11.9.0
QA_POPPLER_MIN_VERSION=24.02.0
