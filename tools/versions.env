# Official Gitleaks release manifest digest; the mutable upstream release has no immutable attestation.
GITLEAKS_VERSION=v8.30.1
GITLEAKS_CHECKSUMS_SHA256=061476c21adaf5441516f96f185c1a4706a83cd6329b9b38762271b3d4a52fae

# Independent PDF QA tools used by tests as oracles (development and CI only; PDFConcat never runs them).
# Windows installs these exact Chocolatey versions. Linux and macOS install the distribution's or
# Homebrew's current packages, which cannot be pinned, so every platform enforces the minimum
# versions below (the oldest the tests were written against) and prints what it installed.
CHOCO_QPDF_VERSION=12.4.2
CHOCO_POPPLER_VERSION=26.9.0
QA_QPDF_MIN_VERSION=11.9.0
QA_POPPLER_MIN_VERSION=24.02.0
